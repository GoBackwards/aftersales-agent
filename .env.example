# Copy to .env and enter your own API key locally. Never commit .env.
LLM_PROVIDER=deepseek
# DeepSeek strict tool mode: the planning call is constrained to its JSON schema,
# which stops truncated tool-call JSON. It needs the /beta endpoint; to turn it off,
# use https://api.deepseek.com and remove LLM_STRICT_TOOLS.
LLM_BASE_URL=https://api.deepseek.com/beta
LLM_STRICT_TOOLS=1
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=45
