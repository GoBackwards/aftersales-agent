{
 "schema_version": "golden-scenario-v1",
 "scenario_id": "G15-handoff-ticket-and-withdrawal",
 "summary": "B4a：常驻的找人工按钮不调模型就开一张人工工单（H-0001，待处理），回复按记录说出工单号和状态、可以撤回，再给一个现在就能用的原平台渠道；原样重发同一次点击只回放保存的结果；会话里有确认卡时再按一次只追加事件、不新建工单，回复另写一句：那张卡照旧可用，要提交还得本人去点，卡本身不变；撤回后状态改为已撤回，不能再撤回一次；之后再按开第二张工单；工单从不碰卡，卡仍只由点击提交；工单列表按记录给出两张工单的状态",
 "covers": ["B4a", "HR1", "A3", "A5", "A6", "W1", "W3", "W4", "I1", "I6"],
 "customers": ["alice"],
 "steps": [
  {"id": "open", "as": "alice", "call": "POST /sessions", "body": {}, "save": {"sid": "session_id"},
   "expect": {"status": 201}},
  {"id": "button-opens-a-ticket", "as": "alice", "call": "POST /sessions/{sid}/handoff",
   "body": {"request_id": "g15-first"},
   "save": {"first": "ticket.ticket_id"},
   "expect": {"status": 200, "model_calls": 0,
              "response": {"ticket_outcome": "opened", "ticket.short_no": "H-0001", "ticket.status": "pending",
                           "@ticket_card": {"short_no": "H-0001", "status": "pending", "actions": ["withdraw"]},
                           "last_reply": {"$ordered": ["已提交人工工单 H-0001", "当前状态：待处理", "可以随时撤回",
                                                       "原平台对应订单或服务页面的客服渠道"]},
                           "@demo_words": 0},
              "db": {"counts": {"tickets": 1, "tickets[status=pending,urgency=normal,summary_written=1]": 1,
                                "ticket_events": 1, "ticket_events[kind=opened,trigger=user_request]": 1,
                                "session_runs": 0},
                     "unchanged": ["orders", "return_requests", "return_cards"]}}},
  {"id": "same-request-id-replays", "as": "alice", "call": "POST /sessions/{sid}/handoff",
   "body": {"request_id": "g15-first"},
   "expect": {"status": 200, "model_calls": 0,
              "response": {"ticket_outcome": "opened", "ticket.short_no": "H-0001"}, "db": {"unchanged": "all"}}},
  {"id": "a-card-in-chat", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "O1001 这单退掉", "request_id": "g15-card"},
   "model": [{"plan": {"items": [{"kind": "return_request", "quote": "退掉", "order_quote": "O1001", "order_id": "O1001"}]}}],
   "save": {"action": "confirmation.action_id", "version": "confirmation.version"},
   "expect": {"status": 200, "model_calls": 1,
              "response": {"confirmation.status": "available", "@open_card_orders": ["O1001"]},
              "db": {"unchanged": ["tickets", "ticket_events", "return_requests"]}}},
  {"id": "button-again-appends", "as": "alice", "call": "POST /sessions/{sid}/handoff",
   "body": {"request_id": "g15-again"},
   "expect": {"status": 200, "model_calls": 0,
              "response": {"ticket_outcome": "appended", "ticket.short_no": "H-0001", "ticket.status": "pending",
                           "last_reply": {"$ordered": ["已追加到人工工单 H-0001", "当前状态：待处理",
                                                       "原平台对应订单或服务页面的客服渠道",
                                                       "确认卡仍然有效，提交仍需你本人点按"]},
                           "@open_card_orders": ["O1001"]},
              "db": {"counts": {"tickets": 1, "ticket_events": 2, "ticket_events[kind=appended]": 1},
                     "unchanged": ["orders", "return_requests", "return_cards", "session_runs"]}}},
  {"id": "withdraw", "as": "alice", "call": "POST /sessions/{sid}/tickets/{first}/withdraw",
   "body": {"request_id": "g15-withdraw"},
   "expect": {"status": 200, "model_calls": 0,
              "response": {"ticket_outcome": "withdrawn", "ticket.status": "cancelled",
                           "@ticket_card": {"short_no": "H-0001", "status": "cancelled", "actions": []},
                           "last_reply": "人工工单 H-0001 已撤回。", "@open_card_orders": ["O1001"]},
              "db": {"counts": {"tickets[status=cancelled]": 1, "ticket_events": 3, "ticket_events[kind=withdrawn]": 1},
                     "unchanged": ["orders", "return_requests", "return_cards", "session_runs"]}}},
  {"id": "withdraw-again-is-refused", "as": "alice", "call": "POST /sessions/{sid}/tickets/{first}/withdraw",
   "body": {"request_id": "g15-withdraw-again"},
   "expect": {"status": 409, "model_calls": 0, "response": {"error.code": "TICKET_CLOSED"},
              "db": {"unchanged_except": ["session_requests"]}}},
  {"id": "button-after-withdrawal-opens-a-second", "as": "alice", "call": "POST /sessions/{sid}/handoff",
   "body": {"request_id": "g15-second"},
   "expect": {"status": 200, "model_calls": 0,
              "response": {"ticket_outcome": "opened", "ticket.short_no": "H-0002", "ticket.status": "pending",
                           "last_reply": {"$contains": "确认卡仍然有效"}},
              "db": {"counts": {"tickets": 2, "tickets[status=pending]": 1},
                     "unchanged": ["orders", "return_requests", "return_cards"]}}},
  {"id": "the-card-is-still-submitted-only-by-its-click", "as": "alice",
   "call": "POST /sessions/{sid}/cards/{action}/confirm",
   "body": {"version": "{version}", "reason_code": "size_or_style", "reason_text": "", "request_id": "g15-click"},
   "expect": {"status": 200, "model_calls": 0, "response": {"return_request.order_id": "O1001"},
              "db": {"rows": {"return_requests": [{"customer_id": "alice", "order_id": "O1001",
                                                   "reason_code": "size_or_style"}]},
                     "unchanged": ["tickets", "ticket_events"]}}},
  {"id": "tickets-listed-with-their-status", "as": "alice", "call": "GET /tickets",
   "expect": {"status": 200, "response": {"@ticket_count": 2, "@ticket_customer_ids": ["alice"],
                                          "@ticket_statuses": [["H-0001", "cancelled"], ["H-0002", "pending"]]},
              "db": {"unchanged": "all"}}},
  {"id": "history-keeps-the-ticket-clicks", "as": "alice", "call": "GET /sessions/{sid}/history",
   "expect": {"status": 200,
              "response": {"@history_entries": ["ticket_handoff", "turn", "ticket_handoff", "ticket_withdraw",
                                                "ticket_withdraw", "ticket_handoff", "card_confirm"]},
              "db": {"unchanged": "all"}}}
 ]
}
