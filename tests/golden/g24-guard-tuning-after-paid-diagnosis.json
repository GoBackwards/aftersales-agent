                                            "answer_selection"]},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "tickets", "ticket_events"]}}},
  {"id": "a-card-turn-declares-the-return-card-as-code", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "O1004 那件我想退掉。", "request_id": "g24-card"},
   "model": [{"plan": {"items": [{"kind": "return_request", "quote": "我想退掉", "order_quote": "O1004", "order_id": "O1004"}]}}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"run_status": "completed", "@business_status": "awaiting_confirmation",
                           "@block_authors": [["business", "code"], ["return_card", "code"]],
                           "@card_block_orders": ["O1004"]},
              "db": {"counts": {"return_cards[status=pending]": 1, "return_requests": 0},
