                           "@dropped": [["G9_ID_IN_TEXT", "note:1"]], "@text_blocks": [["code", 1, "gap"]],
                           "@trace_types": {"$lacks": "structure_correction"}, "@fallback": false},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "tickets", "ticket_events"]}}},
  {"id": "a-record-this-system-does-not-hold-drops-that-note", "as": "alice",
   "call": "POST /sessions/{sid}/messages",
   "body": {"message": "钱到底到了没有？", "request_id": "g24-record"},
   "model": [{"plan": {"items": []}},
             {"answer": {"note": "我这边查到了这单的退款记录。", "path": "refund_progress"}}],
   "expect": {"status": 200, "model_calls": 2,
              "response": {"run_status": "completed",
                           "reply": {"$ordered": ["这一点我这边的资料里没有写到。", "办理路径："]},
                           "@block_authors": [["text", "code"], ["path", "code"]], "@fallback": false,
                           "@dropped": [["G1_CONTACT_WITHOUT_RECORD", "note:1"], ["G1_RECORD_WITHOUT_SOURCE", "note:1"]]},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "tickets", "ticket_events"]}}},
  {"id": "an-answered-item-may-carry-one-follow-up-on-the-first-try", "as": "alice",
   "call": "POST /sessions/{sid}/messages",
   "body": {"message": "拆开看过还能不能退？", "request_id": "g24-ask"},
   "model": [{"plan": {"items": []}},
             {"answer": {"disposition": "answered", "next_step": "",
                         "ask": {"text": "现在包装和配件还齐吗？", "option_set_id": "item_condition"}}}],
   "expect": {"status": 200, "model_calls": 2,
