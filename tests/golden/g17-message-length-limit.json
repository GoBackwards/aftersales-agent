{
 "schema_version": "golden-scenario-v1",
 "scenario_id": "G17-message-length-limit",
 "summary": "B4c 消息长度上限（D15）：/client-info 把上限 2000 字交给页面；多 1 个字的消息返回 400 和代码写的一句话，不调用模型、不建轮次、不写任何行，request_id 也不被占用；正好 2000 字（按字数，不按字节）的消息照常处理；超长被拒不算失败轮，既不计入、也不打断连续失败，所以“失败、两次超长、再失败”仍是连续两个失败轮，开人工工单；会话历史里没有被拒的消息",
 "covers": ["B4c-message-limit", "D15", "I8", "K11"],
 "customers": ["alice"],
 "steps": [
  {"id": "client-info-declares-the-limit", "as": "alice", "call": "GET /client-info",
   "expect": {"status": 200, "response": {"message_limit": 2000}, "db": {"unchanged": "all"}}},
  {"id": "open", "as": "alice", "call": "POST /sessions", "body": {}, "save": {"sid": "session_id"},
   "expect": {"status": 201}},
  {"id": "one-over-the-limit-is-refused", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": {"$repeat": ["长", 2001]}, "request_id": "g17-long"},
   "expect": {"status": 400, "model_calls": 0,
              "response": {"ok": false, "error.code": "MESSAGE_TOO_LONG",
                           "error.message": {"$ordered": ["超过 2000 字", "删减", "分成几条"]}, "@demo_words": 0},
              "db": {"unchanged": "all"}}},
  {"id": "the-session-is-untouched", "as": "alice", "call": "GET /sessions/{sid}",
   "expect": {"status": 200, "response": {"busy": false, "last_reply": "", "card": null},
              "db": {"unchanged": "all"}}},
  {"id": "exactly-the-limit-is-answered-under-the-same-request-id", "as": "alice",
   "call": "POST /sessions/{sid}/messages",
   "body": {"message": {"$repeat": ["长", 2000]}, "request_id": "g17-long"},
   "model": [{"plan": {"items": []}},
             {"answer": {"note": "这段话很长，想先确认你最想解决哪一件？"}}],
   "expect": {"status": 200, "model_calls": 2,
              "response": {"run_status": "completed", "replayed": false, "next_step.action": {"$absent": true}},
              "db": {"counts": {"session_requests": 1, "session_runs[status=completed]": 1}}}},
  {"id": "first-failure", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "再补一句很短的话", "request_id": "g17-fail-1"},
   "model": [{"raise": "model_error"}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"run_status": "model_error", "next_step.action": "retry", "next_step.consecutive_failures": 1},
              "db": {"counts": {"tickets": 0, "session_runs[status=model_error]": 1}}}},
  {"id": "over-long-after-the-failure", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": {"$repeat": ["长", 2500]}, "request_id": "g17-long-2"},
   "expect": {"status": 400, "model_calls": 0, "response": {"error.code": "MESSAGE_TOO_LONG"},
              "db": {"unchanged": "all"}}},
  {"id": "over-long-again", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": {"$repeat": ["长", 2001]}, "request_id": "g17-long-3"},
   "expect": {"status": 400, "model_calls": 0, "response": {"error.code": "MESSAGE_TOO_LONG"},
              "db": {"unchanged": "all"}}},
  {"id": "second-failure-is-the-second-in-a-row", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "再补一句很短的话", "request_id": "g17-fail-2"},
   "model": [{"raise": "model_error"}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"run_status": "model_error", "next_step.action": "ticket",
                           "next_step.consecutive_failures": 2, "next_step.ticket_outcome": "opened",
                           "@ticket_card": {"short_no": "H-0001", "status": "pending", "actions": ["withdraw"]}},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "handoffs"],
                     "counts": {"tickets": 1, "ticket_events[kind=opened,trigger=technical_failure]": 1,
                                "session_runs": 3}}}},
  {"id": "history-has-no-refused-message", "as": "alice", "call": "GET /sessions/{sid}/history",
   "expect": {"status": 200, "response": {"@history_entries": ["turn", "turn", "turn"]}, "db": {"unchanged": "all"}}}
 ]
}
