{
 "schema_version": "golden-scenario-v1",
 "scenario_id": "G18-handoff-offer-and-ticket-records",
 "summary": "B4d：单次失败的下一步除了“重试”，还声明卡上的“找人工”（与顶栏按钮同一个 /handoff 点击）；本人在这一串失败里撤回工单后，第二次失败不再开工单、也不再提供找人工，直到一个完成的轮次结束这一串；之后连续两次失败照常开新工单，追加句不再说“这次请求”，引导句不写次数；工单摘要的需求里，不是本人的订单号一律换成 ****，本人的保留",
 "covers": ["B4d-handoff-offer", "B4d-HN7", "B4d-summary-own-orders", "B4d-failure-copy", "HO4", "HR5", "HN7", "S12c", "§9.4"],
 "customers": ["alice"],
 "steps": [
  {"id": "open", "as": "alice", "call": "POST /sessions", "body": {}, "save": {"sid": "session_id"},
   "expect": {"status": 201}},
  {"id": "first-failure-offers-the-click", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "再问个跟订单无关的小问题", "request_id": "g18-fail-1"},
   "model": [{"raise": "model_error"}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"run_status": "model_error", "next_step.action": "retry", "next_step.consecutive_failures": 1,
                           "next_step.offer_handoff": true, "@ticket_card": {"$absent": true},
                           "reply": "这一轮没有处理完。\n可以点“重试”再发一次这条消息。"},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "tickets", "ticket_events"]}}},
  {"id": "the-cards-click-opens-a-ticket", "as": "alice", "call": "POST /sessions/{sid}/handoff",
   "body": {"request_id": "g18-card-handoff"},
   "save": {"first": "ticket.ticket_id"},
   "expect": {"status": 200, "model_calls": 0,
              "response": {"ticket_outcome": "opened", "ticket.short_no": "H-0001",
                           "@ticket_card": {"short_no": "H-0001", "status": "pending", "actions": ["withdraw"]}},
              "db": {"counts": {"tickets": 1, "ticket_events[kind=opened,trigger=user_request]": 1}}}},
  {"id": "owner-withdraws-within-the-run", "as": "alice", "call": "POST /sessions/{sid}/tickets/{first}/withdraw",
   "body": {"request_id": "g18-withdraw"},
   "expect": {"status": 200, "model_calls": 0, "response": {"ticket_outcome": "withdrawn", "ticket.status": "cancelled"}}},
  {"id": "second-failure-neither-reopens-nor-offers", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "再问个跟订单无关的小问题", "request_id": "g18-fail-2"},
   "model": [{"raise": "model_error"}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"next_step.action": "retry", "next_step.consecutive_failures": 2,
                           "next_step.offer_handoff": false, "@ticket_card": {"$absent": true},
                           "reply": {"$lacks": "人工工单"}},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "tickets", "ticket_events"]}}},
  {"id": "a-completed-turn-ends-the-run", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "那两笔我想放一起看看", "request_id": "g18-done"},
   "model": [{"plan": {"goal": "把 O2001、O1001 两笔并排比一比，外加一笔 2001 元的付款", "items": []}},
             {"answer": {"note": "想先看哪一笔的什么情况？"}}],
   "expect": {"status": 200, "model_calls": 2,
              "response": {"run_status": "completed", "next_step.action": {"$absent": true}},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "tickets", "ticket_events"]}}},
  {"id": "a-new-run-offers-again", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "再问个跟订单无关的小问题", "request_id": "g18-fail-3"},
   "model": [{"raise": "model_error"}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"next_step.action": "retry", "next_step.consecutive_failures": 1,
                           "next_step.offer_handoff": true}}},
  {"id": "its-second-failure-opens-a-ticket", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "再问个跟订单无关的小问题", "request_id": "g18-fail-4"},
   "model": [{"raise": "model_error"}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"next_step.action": "ticket", "next_step.consecutive_failures": 2,
                           "next_step.ticket_outcome": "opened", "next_step.offer_handoff": {"$absent": true},
                           "@ticket_card": {"short_no": "H-0002", "status": "pending", "actions": ["withdraw"]},
                           "reply": {"$ordered": ["这一轮没有处理完。", "上一轮也没有处理完，已提交人工工单 H-0002",
                                                  "请通过原平台"]}},
              "db": {"counts": {"tickets": 2, "ticket_events[kind=opened,trigger=technical_failure]": 1}}}},
  {"id": "a-later-failure-appends-without-a-request", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "再问个跟订单无关的小问题", "request_id": "g18-fail-5"},
   "model": [{"raise": "model_error"}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"next_step.action": "ticket", "next_step.consecutive_failures": 3,
                           "next_step.ticket_outcome": "appended",
                           "reply": {"$contains": "上一轮也没有处理完，已追加到人工工单 H-0002，当前状态：待处理。"}},
              "db": {"counts": {"tickets": 2, "ticket_events[kind=appended,trigger=technical_failure]": 1}}}},
  {"id": "the-append-names-no-request", "as": "alice", "call": "GET /sessions/{sid}",
   "expect": {"status": 200, "response": {"last_reply": {"$lacks": "这次请求"}}, "db": {"unchanged": "all"}}},
  {"id": "summaries-keep-only-own-order-ids", "as": "alice", "call": "GET /tickets",
   "expect": {"status": 200,
              "response": {"@ticket_statuses": [["H-0001", "cancelled"], ["H-0002", "pending"]],
                           "@ticket_needs": [["H-0001", null],
                                             ["H-0002", "把 ****、O1001 两笔并排比一比，外加一笔 2001 元的付款"]],
                           "@ticket_events": [["H-0001", "opened", "user_request"],
                                              ["H-0001", "withdrawn", "user_request"],
                                              ["H-0002", "opened", "technical_failure"],
                                              ["H-0002", "appended", "technical_failure"]]},
              "db": {"unchanged": "all"}}}
 ]
}
