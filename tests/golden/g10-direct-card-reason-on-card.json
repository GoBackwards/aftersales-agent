{
 "schema_version": "golden-scenario-v1",
 "scenario_id": "G10-direct-card-reason-on-card",
 "summary": "B3a（决定 3）：没点名订单的退货请求由本会话上一轮唯一解析出的订单（K5）直接出卡，纯出卡轮只调用一次规划；聊天里说的原因不改卡、只记在轨迹里；无效原因的点击返回 400 且卡不变；选其他并填写说明后写入一条申请，说明只存在申请行里，会话消息只写其他；提交后会话继续（B3c）；订单块的申请退货按钮直接出卡、不调模型；不可退、已有申请、他人订单都不出卡；聊天里明确不要这张卡会作废它（B7：只是暂缓不作废，见 G28）",
 "covers": ["B3a-direct-card", "B3a-reason-on-card", "K5", "I1", "I2", "I3", "I15"],
 "customers": ["alice"],
 "steps": [
  {"id": "open", "as": "alice", "call": "POST /sessions", "body": {}, "save": {"sid": "session_id"},
   "expect": {"status": 201}},
  {"id": "ask-about-the-box", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "收纳盒那单现在什么情况", "request_id": "g10-ask"},
   "model": [{"plan": {"items": [{"kind": "own_order_status", "quote": "收纳盒那单", "order_quote": "收纳盒那单", "order_id": "O1004"}]}}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"@business_status": "order_found", "confirmation.status": "unavailable"},
              "db": {"counts": {"return_cards": 0}, "unchanged": ["orders", "return_requests", "return_cards"]}}},
  {"id": "return-it-without-naming", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "行，那就退掉吧", "request_id": "g10-return"},
   "model": [{"plan": {"items": [{"kind": "return_request", "quote": "退掉吧"}]}}],
   "save": {"action": "confirmation.action_id", "version": "confirmation.version"},
   "expect": {"status": 200, "model_calls": 1,
              "response": {"@business_status": "awaiting_confirmation", "confirmation.status": "available",
                           "confirmation.order_id": "O1004", "@trace_types": {"$contains": "order_resolution"},
                           "@block_types": ["business", "return_card"], "@demo_words": 0,
                           "reply": {"$contains": "的退货确认卡在下方，还没有提交"}},
              "db": {"counts": {"return_cards[status=pending]": 1, "return_requests": 0},
                     "unchanged": ["orders", "return_requests"]}}},
  {"id": "reason-said-in-chat", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "原因你就写成收到时外壳裂了", "request_id": "g10-chat-reason"},
   "model": [{"plan": {"items": [{"kind": "return_request", "quote": "原因你就写成"}]}}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"@business_status": "awaiting_confirmation", "confirmation.order_id": "O1004",
                           "@trace_types": {"$lacks": "reason_ignored"}, "session.card.version": "{version}"},
              "model_requests": [{"tool": "plan_turn", "offered": ["fee_flow", "goal", "items", "order_stage"]}],
              "db": {"unchanged": ["orders", "return_requests", "return_cards"]}}},
  {"id": "click-without-other-text", "as": "alice", "call": "POST /sessions/{sid}/cards/{action}/confirm",
   "body": {"version": "{version}", "reason_code": "other", "reason_text": "   ", "request_id": "g10-click-blank"},
   "expect": {"status": 400, "model_calls": 0, "response": {"error.code": "INVALID_REASON"},
              "db": {"unchanged_except": ["session_requests"], "counts": {"return_requests": 0,
                                                                          "return_cards[status=pending]": 1}}}},
  {"id": "click-with-unknown-code", "as": "alice", "call": "POST /sessions/{sid}/cards/{action}/confirm",
   "body": {"version": "{version}", "reason_code": "free_text", "reason_text": "", "request_id": "g10-click-unknown"},
   "expect": {"status": 400, "model_calls": 0, "response": {"error.code": "INVALID_REASON"},
              "db": {"unchanged_except": ["session_requests"], "counts": {"return_requests": 0}}}},
  {"id": "click-other-with-text", "as": "alice", "call": "POST /sessions/{sid}/cards/{action}/confirm",
   "body": {"version": "{version}", "reason_code": "other", "reason_text": "  柜子尺寸当初量错了  ",
            "request_id": "g10-click"},
   "expect": {"status": 200, "model_calls": 0,
              "response": {"card.status": "consumed", "return_request.order_id": "O1004",
                           "confirmation_message": {"$contains": "原因：其他）"}},
              "db": {"rows": {"return_requests": [{"customer_id": "alice", "order_id": "O1004",
                                                   "reason_code": "other", "reason_text": "柜子尺寸当初量错了",
                                                   "source_action_id": "{action}"}]}}}},
  {"id": "history-after-submission", "as": "alice", "call": "GET /sessions/{sid}/history",
   "expect": {"status": 200,
              "response": {"@history_entries": ["turn", "turn", "turn", "card_confirm", "card_confirm", "card_confirm"]},
              "db": {"unchanged": "all"}}},
  {"id": "session-goes-on-after-submission", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "接着查查 O1001", "request_id": "g10-after"},
   "model": [{"plan": {"items": [{"kind": "own_order_status", "quote": "O1001", "order_quote": "O1001", "order_id": "O1001"}]}}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"run_status": "completed", "@business_status": "order_found",
                           "confirmation.status": "unavailable", "session.return_request.order_id": "O1004",
                           "@open_card_orders": []},
              "db": {"unchanged": ["orders", "return_requests", "return_cards"]}}},
  {"id": "open-second", "as": "alice", "call": "POST /sessions", "body": {}, "save": {"second": "session_id"},
   "expect": {"status": 201}},
  {"id": "button-card", "as": "alice", "call": "POST /sessions/{second}/cards",
   "body": {"order_id": "O1001", "request_id": "g10-button"},
   "save": {"action2": "card.action_id"},
   "expect": {"status": 200, "model_calls": 0,
              "response": {"card_outcome": "created", "card.order_id": "O1001", "card.status": "pending"},
              "db": {"counts": {"return_cards[status=pending]": 1, "return_requests": 1},
                     "unchanged": ["orders", "return_requests"]}}},
  {"id": "button-ineligible", "as": "alice", "call": "POST /sessions/{second}/cards",
   "body": {"order_id": "O1003", "request_id": "g10-button-food"},
   "expect": {"status": 409, "model_calls": 0, "response": {"error.code": "RETURN_NOT_ELIGIBLE"},
              "db": {"unchanged_except": ["session_requests"]}}},
  {"id": "button-already-requested", "as": "alice", "call": "POST /sessions/{second}/cards",
   "body": {"order_id": "O1004", "request_id": "g10-button-box"},
   "expect": {"status": 409, "model_calls": 0, "response": {"error.code": "RETURN_ALREADY_REQUESTED"},
              "db": {"unchanged_except": ["session_requests"]}}},
  {"id": "button-foreign-order", "as": "alice", "call": "POST /sessions/{second}/cards",
   "body": {"order_id": "O2001", "request_id": "g10-button-foreign"},
   "expect": {"status": 404, "model_calls": 0, "response": {"error.code": "ORDER_NOT_FOUND"},
              "db": {"unchanged_except": ["session_requests"]}}},
  {"id": "withdraw-in-chat", "as": "alice", "call": "POST /sessions/{second}/messages",
   "body": {"message": "这张卡不要了，作废吧", "request_id": "g10-withdraw"},
   "model": [{"plan": {"items": [{"kind": "withdraw", "quote": "这张卡不要了"}]}}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"@business_status": "card_voided", "confirmation.status": "unavailable",
                           "session.card.status": "voided", "session.card.void_reason": "chat_withdraw"},
              "db": {"counts": {"return_cards[status=voided]": 1, "return_requests": 1},
                     "unchanged": ["orders", "return_requests"]}}}
 ]
}
