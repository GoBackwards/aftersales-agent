{
 "schema_version": "golden-scenario-v1",
 "scenario_id": "G14-withdrawal-and-card-declaration",
 "summary": "B3e：聊天撤回一次最多作废一张卡——同时点名两张、或写了一个对不上本人订单的四位数时都不作废，回复请用户在卡上点暂不提交并列出仍有效的卡；点名一张就只作废那一张；不出卡的不可退回复不再附带确认规则句；按钮重新展示仍有效的卡时声明同一张卡（区块与聊天轮相同）；失败轮先列有效卡、再给唯一的下一步（B4b 起是重试，取代 B3e 的处理记录句）；申请只来自点击",
 "covers": ["B3e", "§4.1-withdraw", "D4", "I1", "I13"],
 "customers": ["alice"],
 "steps": [
  {"id": "open", "as": "alice", "call": "POST /sessions", "body": {}, "save": {"sid": "session_id"},
   "expect": {"status": 201}},
  {"id": "two-cards", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "O1001 跟 O1004 两件都要退回去", "request_id": "g14-two"},
   "model": [{"plan": {"items": [{"kind": "return_request", "quote": "都要退回去", "order_quote": "O1001", "order_id": "O1001"},
                                 {"kind": "return_request", "quote": "都要退回去", "order_quote": "O1004", "order_id": "O1004"}]}}],
   "save": {"cup": "confirmation.cards.0.action_id", "box": "confirmation.cards.1.action_id"},
   "expect": {"status": 200, "model_calls": 1,
              "response": {"@open_card_orders": ["O1001", "O1004"], "@card_block_orders": ["O1001", "O1004"]},
              "db": {"counts": {"return_cards[status=pending]": 2, "return_requests": 0}}}},
  {"id": "withdraw-naming-both", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "O1001、O1004 这两张都不要了", "request_id": "g14-both"},
   "model": [{"plan": {"items": [{"kind": "withdraw", "quote": "都不要了", "order_quote": "O1001", "order_id": "O1001"},
                                 {"kind": "withdraw", "quote": "都不要了", "order_quote": "O1004", "order_id": "O1004"}]}}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"@business_status": "card_choice_needed", "@open_card_orders": ["O1001", "O1004"],
                           "reply": {"$contains": "就点那张卡下方的“暂不提交”按钮"}},
              "db": {"unchanged": ["orders", "return_requests", "return_cards"]}}},
  {"id": "withdraw-with-a-number-of-no-own-order", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "6543 那张撤掉", "request_id": "g14-number"},
   "model": [{"plan": {"items": [{"kind": "withdraw", "quote": "撤掉", "order_quote": "6543"}]}}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"@business_status": "card_choice_needed", "@open_card_orders": ["O1001", "O1004"],
                           "reply": {"$contains": "当前登录的账号里没有订单 “6543”"}},
              "db": {"unchanged": ["orders", "return_requests", "return_cards"]}}},
  {"id": "ineligible-return-states-no-confirmation-rule", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "O1002 也顺带退了吧", "request_id": "g14-ineligible"},
   "model": [{"plan": {"items": [{"kind": "return_request", "quote": "也顺带退了吧", "order_quote": "O1002", "order_id": "O1002"}]}}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"@business_status": "ineligible", "@open_card_orders": ["O1001", "O1004"],
                           "reply": {"$lacks": "只有你本人点按"}},
              "db": {"unchanged": ["orders", "return_requests", "return_cards"]}}},
  {"id": "button-reshows-the-open-card", "as": "alice", "call": "POST /sessions/{sid}/cards",
   "body": {"order_id": "O1001", "request_id": "g14-button"},
   "expect": {"status": 200, "model_calls": 0,
              "response": {"card_outcome": "reshown", "card.status": "pending",
                           "@card_block": {"order_id": "O1001", "version": 1,
                                           "reason_codes": ["changed_mind", "size_or_style", "quality_issue",
                                                            "wrong_or_missing_item", "damaged_on_arrival", "other"],
                                           "carries_reason": false}},
              "db": {"unchanged": ["orders", "return_requests", "return_cards"]}}},
  {"id": "turn-fails-with-two-open-cards", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "顺便再问一句别的事", "request_id": "g14-fails"},
   "model": [{"raise": "model_error"}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"run_status": "model_error", "@open_card_orders": ["O1001", "O1004"],
                           "next_step.action": "retry",
                           "reply": {"$ordered": ["这一轮没有处理完。", "待确认：", "可以点“重试”再发一次这条消息。"]}},
              "db": {"unchanged": ["orders", "return_requests", "return_cards"]}}},
  {"id": "history-keeps-the-button-declaration", "as": "alice", "call": "GET /sessions/{sid}/history",
   "expect": {"status": 200,
              "response": {"@history_entries": ["turn", "turn", "turn", "turn", "card_prepare", "turn"]},
              "db": {"unchanged": "all"}}},
  {"id": "withdraw-by-the-number-of-one-card", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "1004 那张不用留了", "request_id": "g14-one"},
   "model": [{"plan": {"items": [{"kind": "withdraw", "quote": "不用留了", "order_quote": "1004", "order_id": "O1004"}]}}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"@business_status": "card_voided", "@open_card_orders": ["O1001"]},
              "db": {"counts": {"return_cards[status=voided,void_reason=chat_withdraw]": 1,
                                "return_cards[status=pending]": 1, "return_requests": 0},
                     "unchanged": ["orders", "return_requests"]}}},
  {"id": "click-the-remaining-card", "as": "alice", "call": "POST /sessions/{sid}/cards/{cup}/confirm",
   "body": {"version": 1, "reason_code": "wrong_or_missing_item", "reason_text": "", "request_id": "g14-click"},
   "expect": {"status": 200, "model_calls": 0,
              "response": {"card.status": "consumed", "return_request.order_id": "O1001"},
              "db": {"rows": {"return_requests": [{"customer_id": "alice", "order_id": "O1001",
                                                   "reason_code": "wrong_or_missing_item",
                                                   "source_action_id": "{cup}"}]}}}}
 ]
}
