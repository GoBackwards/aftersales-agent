{
 "schema_version": "golden-scenario-v1",
 "scenario_id": "G21-clarification-decided-by-answer",
 "summary": "B5c（B5d2 沿用；B7：规划 schema 里已经没有这个标记，脚本改用问题事项（plan_turn））：规划曾可给问项标出需要补充的事实，但答复请求里没有这个标记：B5d2 起答复读的是代码整理的事项（只有编号、类型、原话、订单和费用主体），答复自己决定问不问、问什么，追问的选项来自代码目录；不问时没有被纠错重来；有卡的轮次只出卡；两次答复结构都不合格时，这一轮按模型失败结束，什么都不写，也不替规划追问",
 "covers": ["B5c-no-hard-clarification-gate", "B5d2-turn-items", "B5d2-structure-failure", "K15", "K17", "D19-R62-C7"],
 "customers": ["alice"],
 "steps": [
  {"id": "open", "as": "alice", "call": "POST /sessions", "body": {}, "save": {"sid": "session_id"},
   "expect": {"status": 201}},
  {"id": "the-planner-mark-never-reaches-the-answer", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "台灯的旋钮转起来发涩，按你们的条款能办吗？", "request_id": "g21-lamp"},
   "model": [{"plan": {"items": [{"kind": "policy_question", "quote": "按你们的条款能办吗？"}]}},
             {"answer": {"note": "条款这边我还没对上。", "path": "policy_page"}}],
   "expect": {"status": 200, "model_calls": 2,
              "model_requests": [{"tool": "plan_turn", "question_fields": {"$absent": true}},
                                 {"tool": "respond", "strict": true, "item_kinds": ["policy_question"],
                                  "question_fields": {"$absent": true},
                                  "context_keys": ["conversation", "option_sets", "paths", "policy_cards",
                                                   "turn_items", "verified"]}],
              "response": {"run_status": "completed",
                           "reply": {"$lacks": "配附件目前"},
                           "@trace_types": {"$contains": "turn_items"}, "confirmation.status": "unavailable",
                           "@demo_words": 0},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "tickets", "ticket_events"],
                     "counts": {"session_runs[status=completed]": 1}}}},
  {"id": "the-question-shown-is-the-one-the-answer-picked", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "拖鞋左右两只颜色深浅不一，条款上怎么讲？", "request_id": "g21-slippers"},
   "model": [{"plan": {"items": [{"kind": "policy_question", "quote": "条款上怎么讲？"}]}},
             {"answer": {"next_step": "", "disposition": "asked",
                         "ask": {"text": "拖鞋是哪天收到的？", "option_set_id": "receipt_date"}}}],
   "expect": {"status": 200, "model_calls": 2,
              "model_requests": [{"tool": "plan_turn"},
                                 {"tool": "respond", "item_kinds": ["policy_question"]}],
              "response": {"run_status": "completed",
                           "reply": "拖鞋是哪天收到的？",
                           "@block_authors": [["ask", "model"]],
                           "@demo_words": 0},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "tickets", "ticket_events"]}}},
  {"id": "a-card-turn-with-a-marked-question-still-only-prepares-the-card", "as": "alice",
   "call": "POST /sessions/{sid}/messages",
   "body": {"message": "O1004 我要退货。另外盖子松动在条款里怎么算？", "request_id": "g21-card"},
   "model": [{"plan": {"items": [{"kind": "return_request", "quote": "我要退货", "order_quote": "O1004", "order_id": "O1004"},
                                 {"kind": "policy_question", "quote": "盖子松动在条款里怎么算？"}]}},
             {"answer": {"note": "这条条款我还没对上。", "path": "policy_page"}}],
   "expect": {"status": 200, "model_calls": 2,
              "model_requests": [{"tool": "plan_turn"},
                                 {"tool": "respond", "item_kinds": ["return_request", "policy_question"]}],
              "response": {"run_status": "completed", "@business_status": "awaiting_confirmation",
                           "confirmation.status": "available", "confirmation.order_id": "O1004",
                           "@card_block_orders": ["O1004"],
                           "reply": {"$lacks": "质量问题还是个人原因"}, "@demo_words": 0},
              "db": {"counts": {"return_cards[status=pending]": 1, "return_requests": 0},
                     "unchanged": ["orders", "return_requests", "tickets", "ticket_events"]}}},
  {"id": "two-invalid-answers-end-the-turn-without-asking", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "相框背板少了一颗卡扣，条款里管这个吗？", "request_id": "g21-frame"},
   "model": [{"plan": {"items": [{"kind": "policy_question", "quote": "条款里管这个吗？"}]}},
             {"tool": "respond", "arguments": {"next_step": ""}},
             {"tool": "respond", "arguments": {"next_step": ""}}],
   "expect": {"status": 200, "model_calls": 3,
              "response": {"run_status": "model_error",
                           "reply": {"$lacks": "商品属于什么品类？"},
                           "@trace_types": {"$contains": "structure_correction"},
                           "confirmation.status": "available", "confirmation.order_id": "O1004", "@demo_words": 0},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "tickets", "ticket_events"],
                     "counts": {"session_runs[status=completed]": 3, "session_runs[status=model_error]": 1,
                                "return_requests": 0}}}}
 ]
}
