{
 "schema_version": "golden-scenario-v1",
 "scenario_id": "G06-model-failure-and-replay",
 "summary": "B4b：一次模型错误不写申请、不开人工工单，也不再写每次失败的处理记录（handoffs 不增）；回复只给一个下一步（重试），供应商的错误信息只留在 error 里；按原 request_id 重放读保存结果、不再调用模型；换新 request_id 重发同一句后，会话照常继续（这正是页面“重试”按钮做的事）",
 "covers": ["I8", "I6"],
 "customers": ["alice"],
 "steps": [
  {"id": "open", "as": "alice", "call": "POST /sessions", "body": {}, "save": {"sid": "session_id"},
   "expect": {"status": 201}},
  {"id": "provider-fails", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "杯子的盖子拧不上，这种情况一般怎么弄", "request_id": "g06-fail"},
   "model": [{"raise": "model_error"}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"run_status": "model_error", "handoff": {"$absent": true},
                           "next_step.action": "retry", "next_step.consecutive_failures": 1,
                           "reply": "这一轮没有处理完。\n可以点“重试”再发一次这条消息。",
                           "error.message": "脚本注入的模型错误。",
                           "session.busy": false, "session.return_request": null},
              "db": {"counts": {"handoffs": 0, "return_requests": 0, "session_runs[status=model_error]": 1},
                     "unchanged": ["orders", "return_requests", "tickets", "ticket_events"]}}},
  {"id": "replay-same-id", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "杯子的盖子拧不上，这种情况一般怎么弄", "request_id": "g06-fail"},
   "expect": {"status": 200, "model_calls": 0,
              "response": {"replayed": true, "run_status": "model_error", "next_step.action": "retry"},
              "db": {"unchanged": "all"}}},
  {"id": "no-ticket-from-a-failure", "as": "alice", "call": "GET /tickets",
   "expect": {"status": 200, "response": {"@ticket_count": 0}, "db": {"unchanged": "all"}}},
  {"id": "next-request-runs", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "杯子的盖子拧不上，这种情况一般怎么弄", "request_id": "g06-retry"},
   "model": [{"plan": {"items": []}},
             {"answer": {"note": "能说一下盖子是哪一圈对不上吗？"}}],
   "expect": {"status": 200, "model_calls": 2,
              "response": {"run_status": "completed", "session.busy": false, "next_step.action": {"$absent": true}},
              "db": {"counts": {"handoffs": 0, "tickets": 0, "session_runs": 2}}}},
  {"id": "history-shows-both-turns", "as": "alice", "call": "GET /sessions/{sid}/history",
   "expect": {"status": 200, "response": {"@history_entries": ["turn", "turn"]}, "db": {"unchanged": "all"}}}
 ]
}
