{
 "schema_version": "golden-scenario-v1",
 "scenario_id": "G29-later-returns-and-plan-v2-corrections",
 "summary": "B7r 规划 v2 修正：用户说要以后再退、或者这次先别提交时，规划给退货事项标 later，程序只列出这一单的信息和申请按钮、说一句没有备卡，什么都不写，也不调答复；下一轮说要办时按 K5 认定刚才那单出卡；对已有的卡暂缓时回复只有待确认提醒、没有兜底句；按商品说法撤回时引导句不带空括号；一条消息里改退另一单是撤回加退货两项；同一条消息里一项退货保留、一项被丢时，保留那项的订单不被覆盖",
 "covers": ["B7r-later", "B7r-item-orders", "B7r-brackets", "B7r-fallback", "K21", "K5", "K20", "D3", "I1", "I6"],
 "customers": ["alice"],
 "steps": [
  {"id": "open", "as": "alice", "call": "POST /sessions", "body": {}, "save": {"sid": "session_id"},
   "expect": {"status": 201}},
  {"id": "a-return-for-later-shows-the-facts-and-prepares-no-card", "as": "alice",
   "call": "POST /sessions/{sid}/messages",
   "body": {"message": "O1004 打算退掉，等我周末有空再弄", "request_id": "g29-later"},
   "model": [{"plan": {"items": [{"kind": "return_request", "subkind": "later", "quote": "打算退掉",
                                  "order_quote": "O1004", "order_id": "O1004"}]}}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"run_status": "completed", "@business_status": "order_found", "@open_card_orders": [],
                           "confirmation.status": "unavailable", "@block_types": ["business"],
                           "reply": {"$ordered": ["这次没有备确认卡，只把订单情况列在这里。", "O1004：",
                                                  "要退哪一单，点它旁边的“申请退货”"]},
                           "@reply_order_ids": ["O1004"], "@fallback": false},
              "model_requests": [{"tool": "plan_turn"}],
              "db": {"counts": {"return_cards": 0, "return_requests": 0},
                     "unchanged": ["orders", "return_requests", "return_cards", "tickets"]}}},
  {"id": "the-next-turn-prepares-the-card-for-the-order-shown", "as": "alice",
   "call": "POST /sessions/{sid}/messages",
   "body": {"message": "周末到了，现在办", "request_id": "g29-now"},
   "model": [{"plan": {"items": [{"kind": "return_request", "quote": "现在办"}]}}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"@business_status": "awaiting_confirmation", "@open_card_orders": ["O1004"],
                           "@trace_types": {"$contains": "order_resolution"}},
              "db": {"counts": {"return_cards[status=pending]": 1, "return_requests": 0},
                     "unchanged": ["orders", "return_requests"]}}},
  {"id": "a-pause-over-the-card-shows-the-reminder-without-the-fallback", "as": "alice",
   "call": "POST /sessions/{sid}/messages",
   "body": {"message": "卡先放着，我再想想", "request_id": "g29-pause"},
   "model": [{"plan": {"items": [{"kind": "chit_chat", "quote": "我再想想"}]}},
             {"answer": {"disposition": "answered"}}],
   "expect": {"status": 200, "model_calls": 2,
              "response": {"run_status": "completed", "confirmation.status": "available",
                           "@open_card_orders": ["O1004"],
                           "reply": {"$ordered": ["待确认：", "的退货确认卡仍然有效"]},
                           "@reply_order_ids": ["O1004"], "@block_types": ["return_card", "text"],
                           "@fallback": false, "@text_blocks": [["code", null, null]],
                           "@trace_types": {"$lacks": "fallback_used"}},
              "model_requests": [{"tool": "plan_turn"}, {"tool": "respond", "item_kinds": ["chit_chat"]}],
              "db": {"unchanged": ["orders", "return_requests", "return_cards"]}}},
  {"id": "a-withdrawal-by-product-words-names-the-order-without-empty-brackets", "as": "alice",
   "call": "POST /sessions/{sid}/messages",
   "body": {"message": "收纳盒那张作废", "request_id": "g29-withdraw"},
   "model": [{"plan": {"items": [{"kind": "withdraw", "quote": "作废", "order_quote": "收纳盒那张",
                                  "order_id": "O1004"}]}}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"@business_status": "card_voided", "@open_card_orders": [],
                           "reply": {"$ordered": ["O1004。", "的确认卡已作废"]}, "@reply_order_ids": ["O1004"]},
              "db": {"counts": {"return_cards[status=voided,void_reason=chat_withdraw]": 1, "return_requests": 0},
                     "unchanged": ["orders", "return_requests"]}}},
  {"id": "a-card-for-another-order", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "O1001 申请退货", "request_id": "g29-card"},
   "model": [{"plan": {"items": [{"kind": "return_request", "quote": "申请退货", "order_quote": "O1001",
                                  "order_id": "O1001"}]}}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"@business_status": "awaiting_confirmation", "@open_card_orders": ["O1001"]},
              "db": {"counts": {"return_cards[status=pending]": 1}, "unchanged": ["orders", "return_requests"]}}},
  {"id": "a-switch-is-a-withdrawal-and-a-return-in-one-turn", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "O1001 算了，换成 O1004 退", "request_id": "g29-switch"},
   "model": [{"plan": {"items": [{"kind": "withdraw", "quote": "算了", "order_quote": "O1001", "order_id": "O1001"},
                                 {"kind": "return_request", "quote": "换成 O1004 退", "order_quote": "O1004",
                                  "order_id": "O1004"}]}}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"run_status": "completed", "@open_card_orders": ["O1004"],
                           "reply": {"$ordered": ["的确认卡已作废", "的退货确认卡在下方"]},
                           "@reply_order_ids": ["O1001", "O1004"]},
              "db": {"counts": {"return_cards[status=voided,void_reason=chat_withdraw]": 2,
                                "return_cards[status=pending]": 1, "return_requests": 0},
                     "unchanged": ["orders", "return_requests"]}}},
  {"id": "a-kept-and-a-dropped-return-keep-their-own-orders", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "O1001 也退，寄回去运费谁出？", "request_id": "g29-kept-dropped"},
   "model": [{"plan": {"items": [{"kind": "return_request", "quote": "O1001 也退", "order_quote": "O1001",
                                  "order_id": "O1001"},
                                 {"kind": "return_request", "quote": "上次那件", "order_quote": "上次那件",
                                  "order_id": "O1002"},
                                 {"kind": "policy_question", "quote": "寄回去运费谁出？",
                                  "fee_subject": "return_shipping"}]}},
             {"answer": {"disposition": "gap", "note": "寄回去的运费归谁，要看订单页上的服务说明。"}}],
   "expect": {"status": 200, "model_calls": 2,
              "response": {"run_status": "completed", "@open_card_orders": ["O1004", "O1001"],
                           "@trace_types": {"$contains": "item_rejected"},
                           "reply": {"$ordered": ["的退货确认卡在下方", "这条消息里有一项要办的事这次没有办理",
                                                  "寄回去的运费归谁，要看订单页上的服务说明。"]}},
              "model_requests": [{"tool": "plan_turn"},
                                 {"tool": "respond", "item_kinds": ["return_request", "policy_question"],
                                  "item_orders": [[1, ["O1001"]], [2, []]]}],
              "db": {"counts": {"return_cards[status=pending]": 2, "return_requests": 0},
                     "unchanged": ["orders", "return_requests"]}}}
 ]
}
