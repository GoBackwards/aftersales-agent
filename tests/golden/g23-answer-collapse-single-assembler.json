{
 "schema_version": "golden-scenario-v1",
 "scenario_id": "G23-answer-collapse-single-assembler",
 "summary": "B5d2 答复坍缩：一个组装器按固定顺序排区块，每块标明作者（模型或代码）。只有拒绝的轮次，这一项（模型的备注和办理路径）排在第一句，后面是代码渲染的订单事实块（B5f 起办理路径跟着它的事项）；有卡的轮次里暗示已提交的备注是守卫命中，只去掉这一段，这一项换成代码按处理结论写的一句（B5e 删除了改写调用，B5f 起不再整段兜底），卡不变、没有申请；消息里写了不属于本账号的订单号，由代码先写一句没有这个订单，再接模型的备注。这些轮次都不写申请和工单，订单不变",
 "covers": ["B5d2-single-assembler", "B5d2-author-marks", "B5d2-guards-G1-G8", "B5e-no-rewrite-call", "B5f-item-lines", "S1", "I1", "I4", "I6"],
 "customers": ["alice"],
 "steps": [
  {"id": "open", "as": "alice", "call": "POST /sessions", "body": {}, "save": {"sid": "session_id"},
   "expect": {"status": 201}},
  {"id": "a-refusal-comes-first-then-code-blocks", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "能直接帮我把杯子的钱退到卡里吗？", "request_id": "g23-refuse"},
   "model": [{"plan": {"items": []}},
             {"answer": {"note": "退款这一步我这里办不了，可以到原平台的退款详情查看。", "disposition": "refused",
                         "path": "refund_progress", "show": ["O1001"]}}],
   "expect": {"status": 200, "model_calls": 2,
              "model_requests": [{"tool": "plan_turn"}, {"tool": "respond", "item_kinds": ["message"]}],
              "response": {"run_status": "completed",
                           "@block_authors": [["text", "model"], ["path", "code"], ["order_facts", "code"]],
                           "reply": {"$ordered": ["退款这一步我这里办不了", "办理路径：", "O1001：学习"]},
                           "@order_fact_orders": ["O1001"], "@fallback": false, "@demo_words": 0},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "tickets", "ticket_events"]}}},
  {"id": "a-card-turn-note-that-implies-submission-is-dropped-alone", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "O1004 我要退货，顺便问下退回去以后多久能处理完？", "request_id": "g23-card"},
   "model": [{"plan": {"items": [{"kind": "return_request", "quote": "我要退货", "order_quote": "O1004", "order_id": "O1004"},
                                 {"kind": "policy_question", "quote": "退回去以后多久能处理完？"}]}},
             {"answer": {"note": "确认卡已经提交，等审核就好。"}}],
   "expect": {"status": 200, "model_calls": 2,
              "model_requests": [{"tool": "plan_turn"},
                                 {"tool": "respond", "item_kinds": ["return_request", "policy_question"]}],
              "response": {"run_status": "completed", "@business_status": "awaiting_confirmation",
                           "confirmation.status": "available", "confirmation.order_id": "O1004",
                           "@card_block_orders": ["O1004"],
                           "@block_authors": [["business", "code"], ["return_card", "code"], ["text", "code"],
                                              ["path", "code"]], "@fallback": false,
                           "@text_blocks": [["code", 2, "gap"]],
                           "reply": {"$lacks": "已经提交"}, "@demo_words": 0},
              "db": {"counts": {"return_cards[status=pending]": 1, "return_requests": 0},
                     "unchanged": ["orders", "return_requests", "tickets", "ticket_events"]}}},
  {"id": "an-order-of-another-account-is-stated-by-code-first", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "O2001 那单现在怎么样了？", "request_id": "g23-foreign"},
   "model": [{"plan": {"items": []}},
             {"answer": {"note": "这个订单号我这里看不到详情。"}}],
   "expect": {"status": 200, "model_calls": 2,
              "response": {"run_status": "completed",
                           "@block_authors": [["return_card", "code"], ["text", "code"], ["text", "model"],
                                              ["path", "code"], ["text", "code"]],
                           "reply": {"$ordered": ["当前登录的账号里没有订单", "O2001", "这个订单号我这里看不到详情。",
                                                  "办理路径：请通过原平台对应订单", "待确认：", "O1004"]},
                           "@trace_types": {"$contains": "identity_boundary"}, "@demo_words": 0},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "tickets", "ticket_events"]}}}
 ]
}
