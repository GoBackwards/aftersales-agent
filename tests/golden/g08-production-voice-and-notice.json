{
 "schema_version": "golden-scenario-v1",
 "scenario_id": "G08-production-voice-and-notice",
 "summary": "B1：演示环境只在一处常驻说明里交代（订单接口带说明和演示业务日期）；代码写给用户的文字里没有演示环境字样：订单列表、不可退、缺信息追问、出卡、点击确认后的会话摘要、他人订单号、模型失败后的回复（B4b 起是失败句加重试，取代处理记录句）都一样；资格句按订单字段生成",
 "covers": ["B1-A0", "B1-notice", "I4", "I6", "I1"],
 "customers": ["alice"],
 "steps": [
  {"id": "orders-with-notice", "as": "alice", "call": "GET /me/orders",
   "expect": {"status": 200, "model_calls": 0,
              "response": {"notice": {"$contains": "演示业务日期是 2026-09-18"},
                           "@listed_order_ids": ["O1001", "O1002", "O1003", "O1004"], "@demo_words": 0},
              "db": {"unchanged": "all"}}},
  {"id": "open", "as": "alice", "call": "POST /sessions", "body": {}, "save": {"sid": "session_id"},
   "expect": {"status": 201}},
  {"id": "list-own-orders", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "把我账号下几单的情况都列一下", "request_id": "g08-list"},
   "model": [{"plan": {"items": [{"kind": "own_order_status", "quote": "我账号下几单", "order_quote": "我账号下几单", "order_id": "all_mine"}]}}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"run_status": "completed", "@business_status": "order_found", "@demo_words": 0,
                           "@reply_order_ids": ["O1001", "O1002", "O1003", "O1004"]},
              "db": {"unchanged": ["orders", "return_requests", "return_cards"]}}},
  {"id": "missing-fields", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "我想退一单", "request_id": "g08-missing"},
   "model": [{"plan": {"items": [{"kind": "return_request", "quote": "我想退一单"}]}}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"run_status": "completed", "@business_status": "clarification_needed", "@demo_words": 0},
              "db": {"unchanged": ["orders", "return_requests", "return_cards"]}}},
  {"id": "ineligible-order", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "饼干礼盒那单帮我退掉，原因是买多了", "request_id": "g08-ineligible"},
   "model": [{"plan": {"items": [{"kind": "return_request", "quote": "帮我退掉", "order_quote": "饼干礼盒那单", "order_id": "O1003"}]}}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"run_status": "completed", "@business_status": "ineligible", "@demo_words": 0,
                           "session.card": null, "confirmation.status": "unavailable"},
              "db": {"unchanged": ["orders", "return_requests", "return_cards"]}}},
  {"id": "card", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "O1001 退了吧，理由：颜色不喜欢", "request_id": "g08-card"},
   "model": [{"plan": {"items": [{"kind": "return_request", "quote": "退了吧", "order_quote": "O1001", "order_id": "O1001"}]}}],
   "save": {"action": "confirmation.action_id", "version": "confirmation.version"},
   "expect": {"status": 200, "model_calls": 1,
              "response": {"run_status": "completed", "@business_status": "awaiting_confirmation",
                           "confirmation.status": "available", "confirmation.order_id": "O1001", "@demo_words": 0},
              "db": {"counts": {"return_requests": 0, "return_cards[status=pending]": 1},
                     "unchanged": ["orders", "return_requests"]}}},
  {"id": "click", "as": "alice", "call": "POST /sessions/{sid}/cards/{action}/confirm",
   "body": {"version": "{version}", "reason_code": "changed_mind", "reason_text": "", "request_id": "g08-click"},
   "expect": {"status": 200, "model_calls": 0,
              "response": {"return_request.order_id": "O1001", "card.status": "consumed", "@demo_words": 0},
              "db": {"counts": {"return_requests": 1}, "unchanged": ["orders"]}}},
  {"id": "orders-after-click", "as": "alice", "call": "GET /me/orders",
   "expect": {"status": 200, "response": {"@demo_words": 0}, "db": {"unchanged": "all"}}},
  {"id": "open-second", "as": "alice", "call": "POST /sessions", "body": {}, "save": {"second": "session_id"},
   "expect": {"status": 201}},
  {"id": "foreign-order", "as": "alice", "call": "POST /sessions/{second}/messages",
   "body": {"message": "O2001 那单也一起退，理由：送错人了", "request_id": "g08-foreign"},
   "model": [{"plan": {"items": [{"kind": "return_request", "quote": "一起退", "order_quote": "O2001"}]}}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"run_status": "completed", "@business_error": "ORDER_NOT_FOUND",
                           "@reply_order_ids": ["O2001"], "@block_types": ["business"], "@demo_words": 0,
                           "session.card": null},
              "db": {"unchanged": ["orders", "return_requests", "return_cards"]}}},
  {"id": "model-fails", "as": "alice", "call": "POST /sessions/{second}/messages",
   "body": {"message": "那就算了，再看看别的", "request_id": "g08-fail"},
   "model": [{"raise": "model_error"}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"run_status": "model_error", "next_step.action": "retry", "@demo_words": 0},
              "db": {"counts": {"handoffs": 0}, "unchanged": ["orders", "return_requests", "tickets"]}}}
 ]
}
