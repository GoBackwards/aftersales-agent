{
 "schema_version": "golden-scenario-v1",
 "scenario_id": "G09-return-rule-v2",
 "summary": "B2：资格规则 v2（决定 D6）。订单表记录商品状态 condition，五笔种子订单结论不变；超过 7 天的退货请求不出卡，回复按退货规则说明原因，并紧接一句原平台售后入口的质量问题路径；拆过封的食品同样不出卡，也没有这句路径；签收后第 7 天当天也能出卡，申请只由点击产生",
 "covers": ["B2-rule-v2", "B2-quality-path", "D6", "I1", "I7"],
 "customers": ["alice"],
 "steps": [
  {"id": "orders-with-conditions", "as": "alice", "call": "GET /me/orders",
   "expect": {"status": 200, "model_calls": 0,
              "response": {"@listed_order_ids": ["O1001", "O1002", "O1003", "O1004"], "@demo_words": 0},
              "db": {"unchanged": "all",
                     "rows": {"orders": [{"order_id": "O1001", "condition": "sealed", "opened": "<absent>"},
                                         {"order_id": "O1002", "condition": "sealed"},
                                         {"order_id": "O1003", "condition": "inspected_only"},
                                         {"order_id": "O1004", "condition": "sealed"},
                                         {"order_id": "O2001", "condition": "sealed"}]}}}},
  {"id": "open", "as": "alice", "call": "POST /sessions", "body": {}, "save": {"sid": "session_id"},
   "expect": {"status": 201}},
  {"id": "past-window", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "帆布包那单我想退，背了一阵后肩带的线脱了", "request_id": "g09-past-window"},
   "model": [{"plan": {"items": [{"kind": "return_request", "quote": "我想退", "order_quote": "帆布包那单", "order_id": "O1002"}]}}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"run_status": "completed", "@business_status": "ineligible", "@demo_words": 0,
                           "@reply_order_ids": ["O1002"],
                           "reply": {"$ordered": ["这一单签收到现在已超过 7 天，最后可退日是 2026-09-08", "请到原平台这笔订单的售后入口按质量问题提交"]},
                           "session.card": null, "confirmation.status": "unavailable"},
              "db": {"unchanged": ["orders", "return_requests", "return_cards"]}}},
  {"id": "opened-food", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "饼干礼盒的包装我打开瞧过，这单也退了吧", "request_id": "g09-opened-food"},
   "model": [{"plan": {"items": [{"kind": "return_request", "quote": "这单也退了吧", "order_quote": "饼干礼盒", "order_id": "O1003"}]}}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"run_status": "completed", "@business_status": "ineligible", "@demo_words": 0,
                           "reply": {"$contains": "这一单是食品，拆封以后不能在这里申请退货。"},
                           "session.card": null, "confirmation.status": "unavailable"},
              "db": {"unchanged": ["orders", "return_requests", "return_cards"]}}},
  {"id": "seventh-day-card", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "收纳盒今天刚好第七天，帮我退，嫌它太占地方", "request_id": "g09-seventh-day"},
   "model": [{"plan": {"items": [{"kind": "return_request", "quote": "帮我退", "order_quote": "收纳盒", "order_id": "O1004"}]}}],
   "save": {"action": "confirmation.action_id", "version": "confirmation.version"},
   "expect": {"status": 200, "model_calls": 1,
              "response": {"run_status": "completed", "@business_status": "awaiting_confirmation",
                           "confirmation.status": "available", "confirmation.order_id": "O1004", "@demo_words": 0},
              "db": {"counts": {"return_requests": 0, "return_cards[status=pending]": 1},
                     "unchanged": ["orders", "return_requests"]}}},
  {"id": "click", "as": "alice", "call": "POST /sessions/{sid}/cards/{action}/confirm",
   "body": {"version": "{version}", "reason_code": "changed_mind", "reason_text": "", "request_id": "g09-click"},
   "expect": {"status": 200, "model_calls": 0,
              "response": {"return_request.order_id": "O1004", "card.status": "consumed", "@demo_words": 0},
              "db": {"counts": {"return_requests": 1}, "unchanged": ["orders"],
                     "rows": {"return_requests": [{"order_id": "O1004", "reason_code": "changed_mind"}]}}}}
 ]
}
