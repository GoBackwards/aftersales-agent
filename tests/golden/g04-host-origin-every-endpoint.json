{
 "schema_version": "golden-scenario-v1",
 "scenario_id": "G04-host-origin-every-endpoint",
 "summary": "I15 的 Host/Origin 校验：每个端点（B3a 起含出卡与点击确认，B3b 起含作废，B4a 起含找人工、撤回工单和工单列表）在错误 Host、跨站 Origin、跨站 Sec-Fetch-Site 下都在鉴权和读写之前被拒绝，数据库不变",
 "covers": ["I15"],
 "customers": ["alice"],
 "steps": [
  {"id": "open", "as": "alice", "call": "POST /sessions", "body": {},
   "save": {"sid": "session_id"}, "expect": {"status": 201}},
  {"id": "wrong-host", "as": "alice",
   "calls": ["GET /client-info", "POST /sessions", "GET /sessions/{sid}", "GET /sessions/{sid}/history",
             "GET /sessions/{sid}/runs/RUN-none", "POST /sessions/{sid}/messages", "POST /sessions/{sid}/cards",
             "POST /sessions/{sid}/cards/ACT-none/confirm", "POST /sessions/{sid}/cards/ACT-none/void",
             "POST /sessions/{sid}/handoff", "POST /sessions/{sid}/tickets/TKT-none/withdraw",
             "POST /sessions/{sid}/cancel", "POST /sessions/{sid}/recover",
             "GET /tickets", "GET /me/orders", "GET /me/sessions", "GET /demo/identities", "POST /demo/login",
             "GET /kb/cards", "GET /"],
   "headers": {"Host": "attacker.invalid:80"},
   "expect": {"status": 400, "model_calls": 0, "response": {"error.code": "INVALID_HOST"}, "db": {"unchanged": "all"}}},
  {"id": "cross-origin", "as": "alice",
   "calls": ["GET /client-info", "POST /sessions", "GET /sessions/{sid}", "GET /sessions/{sid}/history",
             "GET /sessions/{sid}/runs/RUN-none", "POST /sessions/{sid}/messages", "POST /sessions/{sid}/cards",
             "POST /sessions/{sid}/cards/ACT-none/confirm", "POST /sessions/{sid}/cards/ACT-none/void",
             "POST /sessions/{sid}/handoff", "POST /sessions/{sid}/tickets/TKT-none/withdraw",
             "POST /sessions/{sid}/cancel", "POST /sessions/{sid}/recover",
             "GET /tickets", "GET /me/orders", "GET /me/sessions", "GET /demo/identities", "POST /demo/login",
             "GET /kb/cards", "GET /"],
   "headers": {"Origin": "http://attacker.invalid"},
   "expect": {"status": 403, "model_calls": 0, "response": {"error.code": "ORIGIN_NOT_ALLOWED"},
              "db": {"unchanged": "all"}}},
  {"id": "cross-site-fetch", "as": "alice",
   "calls": ["POST /sessions", "POST /sessions/{sid}/messages", "POST /sessions/{sid}/cards",
             "POST /sessions/{sid}/cards/ACT-none/confirm", "POST /sessions/{sid}/cards/ACT-none/void",
             "POST /sessions/{sid}/handoff", "POST /sessions/{sid}/tickets/TKT-none/withdraw",
             "POST /sessions/{sid}/cancel", "GET /me/orders", "GET /tickets"],
   "headers": {"Sec-Fetch-Site": "cross-site"},
   "expect": {"status": 403, "model_calls": 0, "response": {"error.code": "ORIGIN_NOT_ALLOWED"},
              "db": {"unchanged": "all"}}},
  {"id": "same-origin-is-accepted", "as": "alice", "call": "GET /sessions/{sid}",
   "headers": {"Origin": "http://{host}"},
   "expect": {"status": 200, "response": {"customer_id": "alice"}, "db": {"unchanged": "all"}}},
  {"id": "no-credentials", "as": null, "calls": ["GET /sessions/{sid}", "POST /sessions", "GET /me/orders"],
   "expect": {"status": 401, "response": {"error.code": "UNAUTHORIZED"}, "db": {"unchanged": "all"}}}
 ]
}
