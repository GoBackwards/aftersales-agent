{
 "schema_version": "golden-scenario-v1",
 "scenario_id": "G12-several-cards-session-goes-on",
 "summary": "B3c（D4）：一条消息点名两笔可退订单，各出一张卡，一轮只调一次规划；再说一遍原样重新展示；点名一笔不可退的订单不出卡，另两张卡不变并在回复里说明仍有效；没点名的撤回不作废任何卡、请用户在卡上点暂不提交；点名的撤回只作废那一张；改退另一单（B7：同一轮的撤回加退货两个事项）作废另一单的卡（chat_withdraw）、为新的一单出卡；按钮另出的卡与已有的卡并存；两张卡分别凭点击提交，提交后会话继续；聊天里撤回已提交的申请和对已提交的卡点暂不提交都只给原平台售后撤销入口；另一个会话可以有同一订单自己的卡",
 "covers": ["B3c-several-cards", "B3c-session-goes-on", "D4", "I1", "I3", "I8", "I15"],
 "customers": ["alice"],
 "steps": [
  {"id": "open", "as": "alice", "call": "POST /sessions", "body": {}, "save": {"sid": "session_id"},
   "expect": {"status": 201, "response": {"@open_card_orders": []}}},
  {"id": "two-named-orders", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "O1001 与 O1004 这两单一起办退货", "request_id": "g12-two"},
   "model": [{"plan": {"items": [{"kind": "return_request", "quote": "一起办退货", "order_quote": "O1001", "order_id": "O1001"},
                                 {"kind": "return_request", "quote": "一起办退货", "order_quote": "O1004", "order_id": "O1004"}]}}],
   "save": {"cup": "confirmation.cards.0.action_id", "box": "confirmation.cards.1.action_id"},
   "expect": {"status": 200, "model_calls": 1,
              "response": {"run_status": "completed", "@business_status": "awaiting_confirmation",
                           "@return_outcomes": [["O1001", "created"], ["O1004", "created"]],
                           "@open_card_orders": ["O1001", "O1004"], "@confirmation_card_orders": ["O1001", "O1004"],
                           "@card_block_orders": ["O1001", "O1004"], "confirmation.order_id": "O1004",
                           "@block_types": ["business", "return_card", "return_card"],
                           "reply": {"$contains": "的退货确认卡在下方，还没有提交"}, "@demo_words": 0},
              "db": {"counts": {"return_cards[status=pending]": 2, "return_requests": 0},
                     "unchanged": ["orders", "return_requests"]}}},
  {"id": "same-two-again", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "两张卡再亮一下：O1001、O1004", "request_id": "g12-again"},
   "model": [{"plan": {"items": [{"kind": "return_request", "quote": "两张卡再亮一下", "order_quote": "O1001", "order_id": "O1001"},
                                 {"kind": "return_request", "quote": "两张卡再亮一下", "order_quote": "O1004", "order_id": "O1004"}]}}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"@return_outcomes": [["O1001", "reshown"], ["O1004", "reshown"]],
                           "@open_card_orders": ["O1001", "O1004"]},
              "db": {"unchanged": ["orders", "return_requests", "return_cards"]}}},
  {"id": "an-ineligible-order-leaves-both-cards", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "帆布包 O1002 也退掉", "request_id": "g12-bag"},
   "model": [{"plan": {"items": [{"kind": "return_request", "quote": "也退掉", "order_quote": "O1002", "order_id": "O1002"}]}}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"@business_status": "ineligible", "@open_card_orders": ["O1001", "O1004"],
                           "reply": {"$contains": "O1001、O1004"}, "@reply_order_ids": ["O1001", "O1002", "O1004"]},
              "db": {"unchanged": ["orders", "return_requests", "return_cards"]}}},
  {"id": "unnamed-withdrawal-asks-which-card", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "有一张卡我不想要了", "request_id": "g12-pause-any"},
   "model": [{"plan": {"items": [{"kind": "withdraw", "quote": "有一张卡我不想要了"}]}}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"@business_status": "card_choice_needed", "@open_card_orders": ["O1001", "O1004"],
                           "reply": {"$contains": "暂不提交"}},
              "db": {"unchanged": ["orders", "return_requests", "return_cards"]}}},
  {"id": "named-withdrawal-voids-that-card", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "O1004 那张不要了", "request_id": "g12-pause-box"},
   "model": [{"plan": {"items": [{"kind": "withdraw", "quote": "那张不要了", "order_quote": "O1004", "order_id": "O1004"}]}}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"@business_status": "card_voided", "@open_card_orders": ["O1001"],
                           "@confirmation_card_orders": ["O1001"]},
              "db": {"counts": {"return_cards[status=pending]": 1, "return_cards[void_reason=chat_withdraw]": 1},
                     "unchanged": ["orders", "return_requests"]}}},
  {"id": "switch-to-the-other-order", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "保温杯不退了，改退 O1004", "request_id": "g12-switch"},
   "model": [{"plan": {"items": [{"kind": "withdraw", "quote": "保温杯不退了", "order_quote": "保温杯", "order_id": "O1001"},
                                 {"kind": "return_request", "quote": "改退", "order_quote": "O1004", "order_id": "O1004"}]}}],
   "save": {"box2": "confirmation.action_id"},
   "expect": {"status": 200, "model_calls": 1,
              "response": {"@business_status": "awaiting_confirmation", "@open_card_orders": ["O1004"],
                           "confirmation.order_id": "O1004", "confirmation.version": 2},
              "db": {"counts": {"return_cards[status=pending]": 1, "return_cards[void_reason=chat_withdraw]": 2},
                     "unchanged": ["orders", "return_requests"]}}},
  {"id": "button-card-sits-beside-it", "as": "alice", "call": "POST /sessions/{sid}/cards",
   "body": {"order_id": "O1001", "request_id": "g12-button"},
   "save": {"cup2": "card.action_id"},
   "expect": {"status": 200, "model_calls": 0,
              "response": {"card_outcome": "created", "card.order_id": "O1001", "card.version": 2,
                           "@open_card_orders": ["O1004", "O1001"]},
              "db": {"counts": {"return_cards[status=pending]": 2}, "unchanged": ["orders", "return_requests"]}}},
  {"id": "click-the-cup", "as": "alice", "call": "POST /sessions/{sid}/cards/{cup2}/confirm",
   "body": {"version": 2, "reason_code": "quality_issue", "reason_text": "", "request_id": "g12-click-cup"},
   "expect": {"status": 200, "model_calls": 0,
              "response": {"return_request.order_id": "O1001", "@open_card_orders": ["O1004"],
                           "card.order_id": "O1001", "card.status": "consumed",
                           "confirmation_message": {"$contains": "原因：质量问题"}},
              "db": {"rows": {"return_requests": [{"customer_id": "alice", "order_id": "O1001",
                                                   "reason_code": "quality_issue", "reason_text": null,
                                                   "source_action_id": "{cup2}"}]},
                     "counts": {"return_cards[status=pending]": 1}}}},
  {"id": "session-goes-on", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "O1004 现在什么情况", "request_id": "g12-after-click"},
   "model": [{"plan": {"items": [{"kind": "own_order_status", "quote": "O1004", "order_quote": "O1004", "order_id": "O1004"}]}}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"run_status": "completed", "@business_status": "order_found",
                           "@confirmation_card_orders": ["O1004"], "session.return_request.order_id": "O1001",
                           "reply": {"$contains": "仍然有效，尚未提交"}, "@reply_order_ids": ["O1004"]},
              "db": {"unchanged": ["orders", "return_requests", "return_cards"]}}},
  {"id": "click-the-box", "as": "alice", "call": "POST /sessions/{sid}/cards/{box2}/confirm",
   "body": {"version": 2, "reason_code": "changed_mind", "reason_text": "", "request_id": "g12-click-box"},
   "expect": {"status": 200, "model_calls": 0,
              "response": {"return_request.order_id": "O1004", "@open_card_orders": [],
                           "card.order_id": "O1004", "card.status": "consumed"},
              "db": {"counts": {"return_requests": 2, "return_cards[status=consumed]": 2,
                                "return_requests[order_id=O1004,reason_code=changed_mind]": 1}}}},
  {"id": "chat-cannot-undo-a-submission", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "撤回 O1001 那条申请", "request_id": "g12-undo"},
   "model": [{"plan": {"items": [{"kind": "withdraw", "quote": "撤回", "order_quote": "O1001", "order_id": "O1001"}]}}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"@business_status": "submitted_no_undo", "confirmation.status": "unavailable",
                           "reply": {"$contains": "提交后不能在这里撤回"}},
              "db": {"unchanged": ["orders", "return_requests", "return_cards"]}}},
  {"id": "not-now-on-a-submitted-card", "as": "alice", "call": "POST /sessions/{sid}/cards/{cup2}/void",
   "body": {"request_id": "g12-void-late"},
   "expect": {"status": 409, "model_calls": 0,
              "response": {"error.code": "CONFIRMATION_INVALID", "error.message": {"$contains": "售后详情"}},
              "db": {"unchanged_except": ["session_requests"], "counts": {"return_requests": 2}}}},
  {"id": "history", "as": "alice", "call": "GET /sessions/{sid}/history",
   "expect": {"status": 200,
              "response": {"@history_entries": ["turn", "turn", "turn", "turn", "turn", "turn", "card_prepare",
                                                "card_confirm", "turn", "card_confirm", "turn", "card_void"],
                           "@open_card_orders": []},
              "db": {"unchanged": "all"}}},
  {"id": "open-second", "as": "alice", "call": "POST /sessions", "body": {}, "save": {"second": "session_id"},
   "expect": {"status": 201}},
  {"id": "another-session-cannot-reopen-a-submitted-order", "as": "alice", "call": "POST /sessions/{second}/cards",
   "body": {"order_id": "O1004", "request_id": "g12-second-box"},
   "expect": {"status": 409, "model_calls": 0, "response": {"error.code": "RETURN_ALREADY_REQUESTED"},
              "db": {"unchanged_except": ["session_requests"]}}}
 ]
}
