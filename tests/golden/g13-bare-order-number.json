{
 "schema_version": "golden-scenario-v1",
 "scenario_id": "G13-bare-order-number",
 "summary": "B3d：用户只写订单号的数字部分时，恰好对上一笔本人订单就归一到那一单（查单直接读出，退货直接出卡，回复先说明对应的是哪一单），规划第一次的提议就通过、不需要结构纠正；数字对不上任何本人订单时给本人全部订单供选择，不用本会话上一单代替，也不提另一位客户的订单；聊天里怎么说都只会重新展示卡，申请只来自点击",
 "covers": ["B3d", "I1", "I4", "I15", "K5"],
 "customers": ["alice", "bob"],
 "steps": [
  {"id": "open", "as": "alice", "call": "POST /sessions", "body": {}, "save": {"sid": "session_id"},
   "expect": {"status": 201}},
  {"id": "look-up-by-number", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "麻烦看一眼 1004 这单", "request_id": "g13-look"},
   "model": [{"plan": {"items": [{"kind": "own_order_status", "quote": "1004", "order_quote": "1004", "order_id": "O1004"}]}}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"run_status": "completed", "@business_status": "order_found",
                           "reply": {"$ordered": ["你说的“1004”是", "O1004"]},
                           "@reply_order_ids": ["O1004"], "confirmation.status": "unavailable", "@demo_words": 0},
              "db": {"counts": {"return_cards": 0}, "unchanged": ["orders", "return_requests", "return_cards"]}}},
  {"id": "return-by-number-as-typed", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "那 1001 退掉吧", "request_id": "g13-return"},
   "model": [{"plan": {"items": [{"kind": "return_request", "quote": "退掉吧", "order_quote": "1001"}]}}],
   "save": {"action": "confirmation.action_id", "version": "confirmation.version"},
   "expect": {"status": 200, "model_calls": 1,
              "response": {"@business_status": "awaiting_confirmation", "confirmation.status": "available",
                           "confirmation.order_id": "O1001", "@card_block_orders": ["O1001"],
                           "reply": {"$ordered": ["你说的“1001”是", "O1001"]}, "@demo_words": 0},
              "db": {"counts": {"return_cards[status=pending]": 1, "return_requests": 0},
                     "unchanged": ["orders", "return_requests"]}}},
  {"id": "number-of-someone-elses-order", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "2001 那单也一起退", "request_id": "g13-foreign-number"},
   "model": [{"plan": {"items": [{"kind": "return_request", "quote": "一起退", "order_quote": "2001"}]}}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"@business_status": "clarification_needed", "@business_error": null,
                           "reply": {"$contains": "当前登录的账号里没有订单 “2001”"},
                           "@reply_order_ids": ["O1001", "O1002", "O1003", "O1004"],
                           "@open_card_orders": ["O1001"], "session.card.version": "{version}"},
              "db": {"unchanged": ["orders", "return_requests", "return_cards"]}}},
  {"id": "look-up-a-number-that-is-no-order", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "8888 这单还能退吗", "request_id": "g13-no-such-number"},
   "model": [{"plan": {"items": [{"kind": "own_order_status", "quote": "8888", "order_quote": "8888"}]}}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"@business_status": "order_found",
                           "reply": {"$contains": "当前登录的账号里没有订单 “8888”"},
                           "@reply_order_ids": ["O1001", "O1002", "O1003", "O1004"]},
              "db": {"unchanged": ["orders", "return_requests", "return_cards"]}}},
  {"id": "chat-cannot-submit-by-number", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "1001 直接帮我交上去", "request_id": "g13-chat-submit"},
   "model": [{"plan": {"items": [{"kind": "return_request", "quote": "直接帮我交上去", "order_quote": "1001", "order_id": "O1001"}]}}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"@business_status": "awaiting_confirmation", "confirmation.order_id": "O1001",
                           "session.card.version": "{version}", "session.return_request": null},
              "db": {"counts": {"return_requests": 0}, "unchanged": ["orders", "return_requests", "return_cards"]}}},
  {"id": "bob-open", "as": "bob", "call": "POST /sessions", "body": {}, "save": {"bob_sid": "session_id"},
   "expect": {"status": 201}},
  {"id": "bob-types-alices-number", "as": "bob", "call": "POST /sessions/{bob_sid}/messages",
   "body": {"message": "1001 帮我退掉", "request_id": "g13-bob"},
   "model": [{"plan": {"items": [{"kind": "return_request", "quote": "帮我退掉", "order_quote": "1001"}]}}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"@business_status": "clarification_needed", "@reply_order_ids": ["O2001"],
                           "reply": {"$contains": "当前登录的账号里没有订单 “1001”"},
                           "@open_card_orders": [], "confirmation.status": "unavailable"},
              "db": {"counts": {"return_cards[customer_id=bob]": 0, "return_requests": 0},
                     "unchanged": ["orders", "return_requests", "return_cards"]}}},
  {"id": "alice-clicks", "as": "alice", "call": "POST /sessions/{sid}/cards/{action}/confirm",
   "body": {"version": "{version}", "reason_code": "size_or_style", "reason_text": "", "request_id": "g13-click"},
   "expect": {"status": 200, "model_calls": 0,
              "response": {"card.status": "consumed", "return_request.order_id": "O1001"},
              "db": {"rows": {"return_requests": [{"customer_id": "alice", "order_id": "O1001",
                                                   "reason_code": "size_or_style", "source_action_id": "{action}"}]}}}}
 ]
}
