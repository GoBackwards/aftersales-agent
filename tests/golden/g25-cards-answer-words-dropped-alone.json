{
 "schema_version": "golden-scenario-v1",
 "scenario_id": "G25-cards-answer-words-dropped-alone",
 "summary": "B5f 短文按事项收窄：答复不再有整段短文，只有资料缺口、拒绝、转去办理这三类事项各带一句备注，整轮至多一句下一步和一个追问；守卫逐段检查，命中只去掉那一段，这一项换成代码按处理结论写的一句并照常给出办理路径，另一项的备注照常显示；已回答的事项不带备注（由卡片或订单事实展示）；备注里写了卡片来源的发布方名称（数据里的名单）也只去掉这一段；写了编号或同一事项列了两遍只整理掉，不重调；什么都没显示时才用整段兜底句。这些轮次都不写订单、申请、确认卡和工单",
 "covers": ["B5f-notes-per-item", "B5f-piece-dropped-alone", "B5f-item-lines", "B5f-tidy-without-recall", "B5f-fallback-only-when-empty", "D8-G10", "G2", "G9", "S1"],
 "customers": ["alice"],
 "steps": [
  {"id": "open", "as": "alice", "call": "POST /sessions", "body": {}, "save": {"sid": "session_id"},
   "expect": {"status": 201}},
  {"id": "a-promise-in-one-note-drops-that-note-and-the-other-stays", "as": "alice",
   "call": "POST /sessions/{sid}/messages",
   "body": {"message": "台灯底座磕了个角算不算完好？你能帮我直接把钱退了吗？", "request_id": "g25-two"},
   "model": [{"plan": {"items": [{"kind": "policy_question", "quote": "台灯底座磕了个角算不算完好？"},
                                 {"kind": "policy_question", "quote": "你能帮我直接把钱退了吗？"}]}},
             {"tool": "respond",
              "arguments": {"items": [{"index": 1, "disposition": "gap", "path_id": "policy_page",
                                       "note": "我这边的资料没写到磕掉一角算不算影响完好。"},
                                      {"index": 2, "disposition": "refused", "path_id": "refund_progress",
                                       "note": "这里没法直接退钱，商家会尽快联系你处理。"}],
                            "show_order_ids": [], "next_step": "", "ask": {"text": "", "option_set_id": "none"}}}],
   "expect": {"status": 200, "model_calls": 2,
              "model_requests": [{"tool": "plan_turn"},
                                 {"tool": "respond", "strict": true, "item_kinds": ["policy_question", "policy_question"],
                                  "offered": ["ask", "items", "next_step", "show_order_ids"]}],
              "response": {"run_status": "completed",
                           "reply": {"$ordered": ["我这边的资料没写到磕掉一角算不算影响完好。", "办理路径：打开商品详情页",
                                                  "这件事我这里办不了。", "办理路径：在原平台订单的退款详情"]},
                           "@block_authors": [["text", "model"], ["path", "code"], ["text", "code"], ["path", "code"]],
                           "@text_blocks": [["model", 1, null], ["code", 2, "refused"]],
                           "@dropped": [["G2_UNBACKED_PROMISE", "note:2"]], "@fallback": false, "@demo_words": 0},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "tickets", "ticket_events"]}}},
  {"id": "a-publisher-name-in-a-note-is-dropped-and-the-gap-line-stands", "as": "alice",
   "call": "POST /sessions/{sid}/messages",
   "body": {"message": "这种磕碰的说明在哪儿能看全？", "request_id": "g25-publisher"},
   "model": [{"plan": {"items": []}},
             {"answer": {"note": "可以去京东的商品页看看售后说明。", "path": "policy_page"}}],
   "expect": {"status": 200, "model_calls": 2,
              "response": {"run_status": "completed",
                           "reply": {"$ordered": ["这一点我这边的资料里没有写到。", "办理路径："]},
                           "@dropped": [["G10_PUBLISHER_NAMED", "note:1"]], "@fallback": false},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "tickets", "ticket_events"]}}},
  {"id": "an-answered-item-carries-no-note-and-the-next-step-shows", "as": "alice",
   "call": "POST /sessions/{sid}/messages",
   "body": {"message": "那只保温杯现在还来得及退吗？", "request_id": "g25-answered"},
   "model": [{"plan": {"items": []}},
             {"answer": {"disposition": "answered", "show": ["O1001"], "note": "这单还在能退的日子里。",
                         "next_step": "要退的话，点订单旁边的按钮出确认卡。"}}],
   "expect": {"status": 200, "model_calls": 2,
              "response": {"run_status": "completed", "@order_fact_orders": ["O1001"],
                           "@block_authors": [["order_facts", "code"], ["text", "model"]],
                           "@text_blocks": [["model", "next_step", null]],
                           "@dropped": [["G9_NOTE_NOT_ALLOWED", "note:1"]],
                           "reply": {"$lacks": "还在能退的日子里"}, "@fallback": false},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "tickets", "ticket_events"]}}},
  {"id": "an-id-in-a-note-and-a-repeated-row-are-tidied-without-a-second-call", "as": "alice",
   "call": "POST /sessions/{sid}/messages",
   "body": {"message": "磕碰的说明还有别的出处吗？", "request_id": "g25-tidy"},
   "model": [{"plan": {"items": []}},
             {"tool": "respond",
              "arguments": {"items": [{"index": 1, "disposition": "gap", "path_id": "none",
                                       "note": "按[[policy_page]]那一条去看。"},
                                      {"index": 1, "disposition": "routed", "path_id": "merchant_contact", "note": ""}],
                            "show_order_ids": [], "next_step": "", "ask": {"text": "", "option_set_id": "none"}}}],
   "expect": {"status": 200, "model_calls": 2,
              "response": {"run_status": "completed",
                           "reply": {"$ordered": ["这一点我这边的资料里没有写到。", "办理路径：请通过原平台对应订单"]},
                           "@dropped": [["G9_ID_IN_TEXT", "note:1"], ["G9_ITEM_REPEATED", "item:1"],
                                        ["G9_PATH_MISSING", "path:1"]],
                           "@trace_types": {"$lacks": "structure_correction"}, "@fallback": false},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "tickets", "ticket_events"]}}},
  {"id": "only-when-nothing-is-shown-does-the-fallback-stand", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "那磕碰到底怎么算？", "request_id": "g25-empty"},
   "model": [{"plan": {"items": []}},
             {"answer": {"disposition": "answered"}}],
   "expect": {"status": 200, "model_calls": 2,
              "response": {"run_status": "completed",
                           "reply": "这一部分我暂时给不出准确的说明，可以先到原平台这笔订单的页面或在线客服核实。",
                           "@text_blocks": [["code", "fallback", null]], "@fallback": true,
                           "@trace_types": {"$contains": "fallback_used"}, "@demo_words": 0},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "tickets", "ticket_events"],
                     "counts": {"session_runs[status=completed]": 5}}}}
 ]
}
