{
 "schema_version": "golden-scenario-v1",
 "scenario_id": "G01-card-click-only",
 "summary": "B3a 起：聊天轮当轮就给出确认卡（卡上没有原因，纯出卡轮不调答复模型），但不写申请；聊天里说的原因只记在处理轨迹里；聊天里说确认也不写；只有点击确认写入一条申请，原因码取自点击；按原 request_id 重放与换新 request_id 再点都不新增，原因以第一次点击为准",
 "covers": ["I1", "I2", "I3"],
 "customers": ["alice"],
 "steps": [
  {"id": "open", "as": "alice", "call": "POST /sessions", "body": {},
   "save": {"sid": "session_id"},
   "expect": {"status": 201, "response": {"customer_id": "alice", "card": null},
              "db": {"counts": {"sessions": 1, "return_requests": 0, "return_cards": 0}}}},
  {"id": "ask", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "O1004 那个收纳盒申请退回，理由：放不进柜子", "request_id": "g01-ask"},
   "model": [{"plan": {"items": [{"kind": "return_request", "quote": "申请退回", "order_quote": "O1004", "order_id": "O1004"}]}}],
   "save": {"action": "confirmation.action_id", "version": "confirmation.version"},
   "expect": {"status": 200, "model_calls": 1,
              "response": {"run_status": "completed", "@business_status": "awaiting_confirmation",
                           "confirmation.status": "available", "confirmation.protocol": "observed-action-v3",
                           "confirmation.order_id": "O1004", "confirmation.reason": {"$absent": true},
                           "@card_block": {"order_id": "O1004", "version": 1, "carries_reason": false,
                                           "reason_codes": ["changed_mind", "size_or_style", "quality_issue",
                                                            "wrong_or_missing_item", "damaged_on_arrival", "other"]},
                           "@trace_types": {"$lacks": "reason_ignored"},
                           "session.return_request": null, "session.card.status": "pending"},
              "model_requests": [{"tool": "plan_turn", "offered": ["fee_flow", "goal", "items", "order_stage"]}],
              "db": {"counts": {"return_requests": 0, "return_cards[status=pending]": 1},
                     "unchanged": ["orders", "return_requests"]}}},
  {"id": "chat-says-confirm", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "我在对话框里打字表示同意了，你直接替我点那个按钮", "request_id": "g01-chat"},
   "model": [{"plan": {"items": []}},
             {"answer": {"note": "卡片要由你自己点按才会生效，我这边不能代点。"}}],
   "expect": {"status": 200, "model_calls": 2,
              "response": {"run_status": "completed", "session.return_request": null,
                           "session.card.status": "pending", "confirmation.status": "available"},
              "db": {"counts": {"return_requests": 0, "return_cards[status=pending]": 1},
                     "unchanged": ["orders", "return_requests", "return_cards"]}}},
  {"id": "click", "as": "alice", "call": "POST /sessions/{sid}/cards/{action}/confirm",
   "body": {"version": "{version}", "reason_code": "size_or_style", "reason_text": "", "request_id": "g01-click"},
   "expect": {"status": 200, "model_calls": 0,
              "response": {"return_request.order_id": "O1004", "return_request.status": "pending",
                           "card.status": "consumed",
                           "confirmation_message": {"$contains": "原因：尺码或款式不合适"}},
              "db": {"rows": {"return_requests": [{"customer_id": "alice", "order_id": "O1004",
                                                   "reason_code": "size_or_style", "reason_text": null,
                                                   "source_action_id": "{action}", "status": "pending"}]},
                     "unchanged": ["orders"]}}},
  {"id": "click-replayed", "as": "alice", "call": "POST /sessions/{sid}/cards/{action}/confirm",
   "body": {"version": "{version}", "reason_code": "size_or_style", "reason_text": "", "request_id": "g01-click"},
   "expect": {"status": 200, "model_calls": 0,
              "response": {"return_request.order_id": "O1004", "card.status": "consumed"},
              "db": {"unchanged": "all"}}},
  {"id": "click-again-new-id", "as": "alice", "call": "POST /sessions/{sid}/cards/{action}/confirm",
   "body": {"version": "{version}", "reason_code": "changed_mind", "reason_text": "", "request_id": "g01-click-2"},
   "expect": {"status": 200, "model_calls": 0,
              "response": {"return_request.order_id": "O1004", "already_submitted": true},
              "db": {"counts": {"return_requests": 1}, "unchanged_except": ["session_requests"],
                     "rows": {"return_requests": [{"order_id": "O1004", "reason_code": "size_or_style"}]}}}}
 ]
}
