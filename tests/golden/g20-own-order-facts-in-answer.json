{
 "schema_version": "golden-scenario-v1",
 "scenario_id": "G20-own-order-facts-in-answer",
 "summary": "B5b（B5d2 沿用）：答复调用之前，代码把本人全部订单及其规则事实放进 respond 上下文的已核实部分，规划上下文不变；show_order_ids 只能选本人订单号，代码按选中的订单渲染只读的订单事实块（订单行、最后可退日和申请退货的下一步说明），排在本轮动作区块之后、模型短文之前，本轮业务区块已列出的订单和已写过的下一步说明不重复；规划没有给订单引用时也能显示；不是本人的订单号是结构错误（G9），纠错一次，从不显示；已提交的申请只按状态显示，卡上填的其他原因不会出现；这些轮次都不写订单、申请、确认卡和工单",
 "covers": ["B5b-order-facts-prefetch", "B5b-show-order-ids", "B5d2-single-assembler", "K3", "I2", "I4", "D3", "G9"],
 "customers": ["alice", "bob"],
 "steps": [
  {"id": "open", "as": "alice", "call": "POST /sessions", "body": {}, "save": {"sid": "session_id"},
   "expect": {"status": 201}},
  {"id": "facts-shown-without-a-planner-reference", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "杯子到手没几天，还在能退的日子里不？", "request_id": "g20-cup"},
   "model": [{"plan": {"items": []}},
             {"answer": {"next_step": "这只杯子的情况列在上面了。", "disposition": "answered", "show": ["O1001"]}}],
   "expect": {"status": 200, "model_calls": 2,
              "model_requests": [{"tool": "plan_turn", "order_choices": {"$absent": true},
                                  "context_order_ids": ["O1001", "O1002", "O1003", "O1004"]},
                                 {"tool": "respond", "strict": true,
                                  "order_choices": ["O1003", "O1001", "O1004", "O1002"],
                                  "context_order_ids": ["O1001", "O1002", "O1003", "O1004"]}],
              "response": {"run_status": "completed", "@order_fact_orders": ["O1001"],
                           "@block_authors": [["order_facts", "code"], ["text", "model"]],
                           "reply": {"$ordered": ["O1001：", "保温杯，实付", "签收后第 3 天", "可以申请退货，最后可退日是 2026-09-22",
                                                  "点它旁边的“申请退货”", "这只杯子的情况列在上面了。"]},
                           "@trace_types": {"$contains": "order_facts_shown"}, "confirmation.status": "unavailable",
                           "@demo_words": 0},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "tickets", "ticket_events"],
                     "counts": {"session_runs[status=completed]": 1}}}},
  {"id": "an-ineligible-order-states-the-rule-reason", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "那盒饼干也帮我对一下情况", "request_id": "g20-food"},
   "model": [{"plan": {"items": []}},
             {"answer": {"next_step": "饼干那一单也列出来了。", "disposition": "answered", "show": ["O1003"]}}],
   "expect": {"status": 200, "model_calls": 2,
              "response": {"run_status": "completed", "@order_fact_orders": ["O1003"],
                           "reply": {"$ordered": ["O1003：", "饼干礼盒，实付", "这一单是食品，拆封以后不能在这里申请退货",
                                                  "饼干那一单也列出来了。"]},
                           "@demo_words": 0},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "tickets", "ticket_events"]}}},
  {"id": "an-order-the-lookup-shows-is-not-repeated", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "O1004 这单，过了第七天就彻底不行了吗？", "request_id": "g20-lookup"},
   "model": [{"plan": {"items": [{"kind": "own_order_status", "quote": "O1004", "order_quote": "O1004", "order_id": "O1004"},
                                 {"kind": "policy_question", "quote": "过了第七天就彻底不行了吗"}]}},
             {"answer": {"note": "我这边的资料没写到过了期限以后怎么办。", "path": "policy_page",
                         "show": ["O1004", "O1001"]}}],
   "expect": {"status": 200, "model_calls": 2,
              "model_requests": [{"tool": "plan_turn"},
                                 {"tool": "respond", "item_kinds": ["own_order_status", "policy_question"]}],
              "response": {"run_status": "completed", "@business_status": "order_found",
                           "@order_fact_orders": ["O1001"],
                           "@block_authors": [["business", "code"], ["order_facts", "code"], ["text", "model"],
                                              ["path", "code"]],
                           "reply": {"$ordered": ["O1004：", "收纳盒，实付", "点它旁边的“申请退货”",
                                                  "O1001：", "保温杯，实付", "我这边的资料没写到过了期限以后怎么办。",
                                                  "办理路径："]},
                           "@demo_words": 0},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "tickets", "ticket_events"]}}},
  {"id": "card-for-the-cup", "as": "alice", "call": "POST /sessions/{sid}/cards",
   "body": {"order_id": "O1001", "request_id": "g20-card"},
   "save": {"action": "card.action_id", "version": "card.version"},
   "expect": {"status": 200, "model_calls": 0, "response": {"card_outcome": "created", "card.order_id": "O1001"}}},
  {"id": "click-other-with-text", "as": "alice", "call": "POST /sessions/{sid}/cards/{action}/confirm",
   "body": {"version": "{version}", "reason_code": "other", "reason_text": "杯盖颜色和页面上那张图对不上",
            "request_id": "g20-click"},
   "expect": {"status": 200, "model_calls": 0,
              "response": {"card.status": "consumed", "return_request.order_id": "O1001"},
              "db": {"counts": {"return_requests": 1}}}},
  {"id": "a-submitted-request-shows-by-status-only", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "刚提交的杯子那单，现在是什么状态", "request_id": "g20-after-click"},
   "model": [{"plan": {"items": []}},
             {"answer": {"next_step": "这一单的状态见上面。", "disposition": "answered", "show": ["O1001"]}}],
   "expect": {"status": 200, "model_calls": 2,
              "response": {"run_status": "completed", "@order_fact_orders": ["O1001"],
                           "reply": {"$ordered": ["O1001：", "保温杯，实付", "已经有一条退货申请，当前状态：待处理。",
                                                  "这一单的状态见上面。"]},
                           "@demo_words": 0},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "tickets", "ticket_events"]}}},
  {"id": "bob-open", "as": "bob", "call": "POST /sessions", "body": {}, "save": {"bob_sid": "session_id"},
   "expect": {"status": 201}},
  {"id": "only-own-orders-are-offered-and-shown", "as": "bob", "call": "POST /sessions/{bob_sid}/messages",
   "body": {"message": "我这儿的东西还有哪样能退回去", "request_id": "g20-bob"},
   "model": [{"plan": {"items": []}},
             {"answer": {"next_step": "你的订单情况列在上面了。", "disposition": "answered", "show": ["O1001", "O2001"]}},
             {"answer": {"next_step": "你的订单情况列在上面了。", "disposition": "answered", "show": ["O2001"]}}],
   "expect": {"status": 200, "model_calls": 3,
              "model_requests": [{"tool": "plan_turn", "context_order_ids": ["O2001"]},
                                 {"tool": "respond", "order_choices": ["O2001"], "context_order_ids": ["O2001"]},
                                 {"tool": "respond", "order_choices": ["O2001"]}],
              "response": {"run_status": "completed", "@order_fact_orders": ["O2001"],
                           "@reply_order_ids": ["O2001"], "@trace_types": {"$contains": "structure_correction"},
                           "@demo_words": 0},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "tickets", "ticket_events"]}}}
 ]
}
