{
 "schema_version": "golden-scenario-v1",
 "scenario_id": "G02-cross-owner-existing-endpoints",
 "summary": "I15 端点越权清单（B3a 起含出卡与点击确认两个新端点，B3b 起含作废端点，B4a 起含找人工、撤回工单和工单列表）：另一位客户的会话、运行、确认卡、工单在每个端点上都在读写之前被拒绝（404 或 409），数据库不变、不调用模型；在自己的会话里点别人的卡、撤回别人的工单、给别人的订单出卡同样被拒；列表端点只返回本人的数据；对方的卡和工单不受影响，卡仍可由本人确认",
 "covers": ["I15", "I4", "I3"],
 "customers": ["alice", "bob"],
 "steps": [
  {"id": "bob-open", "as": "bob", "call": "POST /sessions", "body": {},
   "save": {"sid_b": "session_id"},
   "expect": {"status": 201}},
  {"id": "bob-card", "as": "bob", "call": "POST /sessions/{sid_b}/messages",
   "body": {"message": "O2001 这本笔记本用不上，申请退回，理由：页数太少", "request_id": "g02-bob-card"},
   "model": [{"plan": {"items": [{"kind": "return_request", "quote": "申请退回", "order_quote": "O2001", "order_id": "O2001"}]}}],
   "save": {"action_b": "confirmation.action_id", "version_b": "confirmation.version", "run_b": "run_id"},
   "expect": {"status": 200, "model_calls": 1,
              "response": {"confirmation.status": "available", "confirmation.order_id": "O2001"}}},
  {"id": "bob-second-session", "as": "bob", "call": "POST /sessions", "body": {},
   "save": {"sid_b2": "session_id"}, "expect": {"status": 201}},
  {"id": "bob-failed-turn", "as": "bob", "call": "POST /sessions/{sid_b2}/messages",
   "body": {"message": "先随便问问，看看这边能做什么", "request_id": "g02-bob-fail"},
   "model": [{"raise": "model_error"}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"run_status": "model_error", "next_step.action": "retry", "handoff": {"$absent": true}},
              "db": {"counts": {"handoffs": 0, "tickets": 0}}}},
  {"id": "bob-handoff", "as": "bob", "call": "POST /sessions/{sid_b}/handoff", "body": {"request_id": "g02-bob-handoff"},
   "save": {"ticket_b": "ticket.ticket_id"},
   "expect": {"status": 200, "model_calls": 0,
              "response": {"ticket_outcome": "opened", "ticket.short_no": "H-0001", "ticket.status": "pending"},
              "db": {"counts": {"tickets": 1, "tickets[customer_id=bob,status=pending]": 1, "ticket_events": 1}}}},
  {"id": "alice-open", "as": "alice", "call": "POST /sessions", "body": {},
   "save": {"sid_a": "session_id"}, "expect": {"status": 201}},
  {"id": "read-session", "as": "alice", "call": "GET /sessions/{sid_b}",
   "expect": {"status": 404, "response": {"error.code": "SESSION_NOT_FOUND"}, "db": {"unchanged": "all"}}},
  {"id": "read-history", "as": "alice", "call": "GET /sessions/{sid_b}/history",
   "expect": {"status": 404, "response": {"error.code": "SESSION_NOT_FOUND"}, "db": {"unchanged": "all"}}},
  {"id": "read-run", "as": "alice", "call": "GET /sessions/{sid_b}/runs/{run_b}",
   "expect": {"status": 404, "response": {"error.code": "SESSION_NOT_FOUND"}, "db": {"unchanged": "all"}}},
  {"id": "read-run-through-own-session", "as": "alice", "call": "GET /sessions/{sid_a}/runs/{run_b}",
   "expect": {"status": 404, "response": {"error.code": "RUN_NOT_FOUND"}, "db": {"unchanged": "all"}}},
  {"id": "message-into-other-session", "as": "alice", "call": "POST /sessions/{sid_b}/messages",
   "body": {"message": "帮我看一下这个会话里的卡", "request_id": "g02-alice-msg"},
   "expect": {"status": 404, "model_calls": 0, "response": {"error.code": "SESSION_NOT_FOUND"},
              "db": {"unchanged": "all"}}},
  {"id": "card-in-other-session", "as": "alice", "call": "POST /sessions/{sid_b}/cards",
   "body": {"order_id": "O1001", "request_id": "g02-alice-card"},
   "expect": {"status": 404, "model_calls": 0, "response": {"error.code": "SESSION_NOT_FOUND"},
              "db": {"unchanged": "all"}}},
  {"id": "confirm-in-other-session", "as": "alice", "call": "POST /sessions/{sid_b}/cards/{action_b}/confirm",
   "body": {"version": "{version_b}", "reason_code": "changed_mind", "reason_text": "", "request_id": "g02-alice-click"},
   "expect": {"status": 404, "model_calls": 0, "response": {"error.code": "SESSION_NOT_FOUND"},
              "db": {"unchanged": "all"}}},
  {"id": "void-in-other-session", "as": "alice", "call": "POST /sessions/{sid_b}/cards/{action_b}/void",
   "body": {"request_id": "g02-alice-void"},
   "expect": {"status": 404, "model_calls": 0, "response": {"error.code": "SESSION_NOT_FOUND"},
              "db": {"unchanged": "all"}}},
  {"id": "handoff-into-other-session", "as": "alice", "call": "POST /sessions/{sid_b}/handoff",
   "body": {"request_id": "g02-alice-handoff"},
   "expect": {"status": 404, "model_calls": 0, "response": {"error.code": "SESSION_NOT_FOUND"},
              "db": {"unchanged": "all"}}},
  {"id": "withdraw-in-other-session", "as": "alice", "call": "POST /sessions/{sid_b}/tickets/{ticket_b}/withdraw",
   "body": {"request_id": "g02-alice-withdraw"},
   "expect": {"status": 404, "model_calls": 0, "response": {"error.code": "SESSION_NOT_FOUND"},
              "db": {"unchanged": "all"}}},
  {"id": "cancel-other-session", "as": "alice", "call": "POST /sessions/{sid_b}/cancel",
   "body": {"request_id": "g02-alice-cancel"},
   "expect": {"status": 404, "response": {"error.code": "SESSION_NOT_FOUND"}, "db": {"unchanged": "all"}}},
  {"id": "recover-other-session", "as": "alice", "call": "POST /sessions/{sid_b}/recover",
   "body": {"request_id": "g02-alice-recover"},
   "expect": {"status": 404, "response": {"error.code": "SESSION_NOT_FOUND"}, "db": {"unchanged": "all"}}},
  {"id": "foreign-card-in-own-session", "as": "alice", "call": "POST /sessions/{sid_a}/cards/{action_b}/confirm",
   "body": {"version": "{version_b}", "reason_code": "changed_mind", "reason_text": "", "request_id": "g02-alice-own"},
   "expect": {"status": 409, "model_calls": 0, "response": {"error.code": "CONFIRMATION_INVALID"},
              "db": {"unchanged_except": ["session_requests"], "counts": {"return_requests": 0},
                     "rows": {"session_requests": [{"customer_id": "bob"}, {"customer_id": "bob"},
                                                   {"customer_id": "bob", "entry": "ticket_handoff"},
                                                   {"customer_id": "alice", "entry": "card_confirm",
                                                    "status": "failed"}]}}}},
  {"id": "foreign-order-card-in-own-session", "as": "alice", "call": "POST /sessions/{sid_a}/cards",
   "body": {"order_id": "O2001", "request_id": "g02-alice-foreign-order"},
   "expect": {"status": 404, "model_calls": 0, "response": {"error.code": "ORDER_NOT_FOUND"},
              "db": {"unchanged_except": ["session_requests"], "counts": {"return_cards": 1}}}},
  {"id": "foreign-card-void-in-own-session", "as": "alice", "call": "POST /sessions/{sid_a}/cards/{action_b}/void",
   "body": {"request_id": "g02-alice-own-void"},
   "expect": {"status": 409, "model_calls": 0, "response": {"error.code": "CONFIRMATION_INVALID"},
              "db": {"unchanged_except": ["session_requests"], "counts": {"return_cards[status=pending]": 1}}}},
  {"id": "foreign-ticket-withdraw-in-own-session", "as": "alice",
   "call": "POST /sessions/{sid_a}/tickets/{ticket_b}/withdraw", "body": {"request_id": "g02-alice-own-withdraw"},
   "expect": {"status": 404, "model_calls": 0, "response": {"error.code": "TICKET_NOT_FOUND"},
              "db": {"unchanged_except": ["session_requests"], "counts": {"tickets[status=pending]": 1}}}},
  {"id": "list-own-orders", "as": "alice", "call": "GET /me/orders",
   "expect": {"status": 200, "response": {"@listed_order_ids": ["O1001", "O1002", "O1003", "O1004"]},
              "db": {"unchanged": "all"}}},
  {"id": "list-own-sessions", "as": "alice", "call": "GET /me/sessions",
   "expect": {"status": 200, "response": {"@listed_session_ids": ["{sid_a}"]}, "db": {"unchanged": "all"}}},
  {"id": "list-own-tickets", "as": "alice", "call": "GET /tickets",
   "expect": {"status": 200, "response": {"@ticket_count": 0}, "db": {"unchanged": "all"}}},
  {"id": "bob-lists-tickets", "as": "bob", "call": "GET /tickets",
   "expect": {"status": 200, "response": {"@ticket_count": 1, "@ticket_customer_ids": ["bob"],
                                          "@ticket_statuses": [["H-0001", "pending"]]}}},
  {"id": "bob-card-untouched", "as": "bob", "call": "GET /sessions/{sid_b}",
   "expect": {"status": 200, "response": {"card.status": "pending", "card.order_id": "O2001",
                                          "return_request": null}}},
  {"id": "bob-clicks", "as": "bob", "call": "POST /sessions/{sid_b}/cards/{action_b}/confirm",
   "body": {"version": "{version_b}", "reason_code": "quality_issue", "reason_text": "", "request_id": "g02-bob-click"},
   "expect": {"status": 200, "response": {"return_request.order_id": "O2001"},
              "db": {"rows": {"return_requests": [{"customer_id": "bob", "order_id": "O2001",
                                                   "reason_code": "quality_issue"}]}}}}
 ]
}
