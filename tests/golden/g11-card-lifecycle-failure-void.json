{
 "schema_version": "golden-scenario-v1",
 "scenario_id": "G11-card-lifecycle-failure-void",
 "summary": "B3b（卡生命周期）：一轮失败后卡不变、不被挂起，失败的响应照常声明这张卡并说明它仍有效；没有运行中的轮次时取消什么都不改；暂不提交走作废端点，卡作废为 user 并追加一句代码写的说明，同一 request_id 重放原结果，换 request_id 或点已作废的卡都被拒；他人和不存在的卡不能作废；再出的卡在又一次失败之后仍能凭点击提交，原因只取自点击（B4b 起这次失败与前一个失败轮之间只有点击、没有完成的轮次，算连续第二个失败轮，开人工工单，卡照旧不变）；提交后的卡不能作废",
 "covers": ["B3b-lifecycle", "B3b-void-endpoint", "K6", "I8", "I3", "I15"],
 "customers": ["alice", "bob"],
 "steps": [
  {"id": "open", "as": "alice", "call": "POST /sessions", "body": {}, "save": {"sid": "session_id"},
   "expect": {"status": 201}},
  {"id": "button-card", "as": "alice", "call": "POST /sessions/{sid}/cards",
   "body": {"order_id": "O1001", "request_id": "g11-button"},
   "save": {"action": "card.action_id", "version": "card.version"},
   "expect": {"status": 200, "model_calls": 0,
              "response": {"card_outcome": "created", "card.order_id": "O1001", "card.status": "pending"},
              "db": {"counts": {"return_cards[status=pending]": 1}}}},
  {"id": "turn-fails-with-open-card", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "我再想想，先问个别的", "request_id": "g11-fail"},
   "model": [{"raise": "model_error"}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"run_status": "model_error", "session.card.status": "pending",
                           "session.card.version": "{version}", "confirmation.status": "available",
                           "confirmation.order_id": "O1001", "@block_types": ["return_card", "text"],
                           "reply": {"$contains": "仍然有效，尚未提交"}},
              "db": {"unchanged": ["orders", "return_requests", "return_cards"],
                     "counts": {"session_runs[status=model_error]": 1}}}},
  {"id": "history-after-failure", "as": "alice", "call": "GET /sessions/{sid}/history",
   "expect": {"status": 200, "response": {"@history_entries": ["card_prepare", "turn"], "session.card.status": "pending"},
              "db": {"unchanged": "all"}}},
  {"id": "cancel-with-nothing-running", "as": "alice", "call": "POST /sessions/{sid}/cancel",
   "body": {"request_id": "g11-cancel"},
   "expect": {"status": 200, "model_calls": 0,
              "response": {"card.status": "pending", "card.version": "{version}", "busy": false},
              "db": {"unchanged_except": ["session_requests"]}}},
  {"id": "other-customer-cannot-void", "as": "bob", "call": "POST /sessions/{sid}/cards/{action}/void",
   "body": {"request_id": "g11-bob-void"},
   "expect": {"status": 404, "model_calls": 0, "response": {"error.code": "SESSION_NOT_FOUND"},
              "db": {"unchanged": "all"}}},
  {"id": "unknown-card-cannot-be-voided", "as": "alice", "call": "POST /sessions/{sid}/cards/ACT-none/void",
   "body": {"request_id": "g11-void-none"},
   "expect": {"status": 409, "model_calls": 0, "response": {"error.code": "CONFIRMATION_INVALID"},
              "db": {"unchanged_except": ["session_requests"], "counts": {"return_cards[status=pending]": 1}}}},
  {"id": "not-now", "as": "alice", "call": "POST /sessions/{sid}/cards/{action}/void",
   "body": {"request_id": "g11-void"},
   "expect": {"status": 200, "model_calls": 0,
              "response": {"card.status": "voided", "card.void_reason": "user", "return_request": null},
              "db": {"changed": ["return_cards", "session_messages", "sessions"],
                     "unchanged": ["orders", "return_requests"],
                     "counts": {"return_cards[status=voided]": 1, "return_cards[status=pending]": 0}}}},
  {"id": "not-now-replayed", "as": "alice", "call": "POST /sessions/{sid}/cards/{action}/void",
   "body": {"request_id": "g11-void"},
   "expect": {"status": 200, "model_calls": 0, "response": {"card.status": "voided"}, "db": {"unchanged": "all"}}},
  {"id": "not-now-twice", "as": "alice", "call": "POST /sessions/{sid}/cards/{action}/void",
   "body": {"request_id": "g11-void-again"},
   "expect": {"status": 409, "model_calls": 0, "response": {"error.code": "CONFIRMATION_INVALID"},
              "db": {"unchanged_except": ["session_requests"]}}},
  {"id": "voided-card-cannot-be-confirmed", "as": "alice", "call": "POST /sessions/{sid}/cards/{action}/confirm",
   "body": {"version": "{version}", "reason_code": "changed_mind", "reason_text": "", "request_id": "g11-click-voided"},
   "expect": {"status": 409, "model_calls": 0, "response": {"error.code": "CONFIRMATION_INVALID"},
              "db": {"unchanged_except": ["session_requests"], "counts": {"return_requests": 0}}}},
  {"id": "button-card-again", "as": "alice", "call": "POST /sessions/{sid}/cards",
   "body": {"order_id": "O1001", "request_id": "g11-button-again"},
   "save": {"action2": "card.action_id"},
   "expect": {"status": 200, "model_calls": 0,
              "response": {"card_outcome": "created", "card.version": 2, "card.status": "pending"}}},
  {"id": "second-turn-fails", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "等一下，刚才那句没发完整", "request_id": "g11-fail-again"},
   "model": [{"raise": "model_error"}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"run_status": "model_error", "session.card.status": "pending", "session.card.version": 2,
                           "confirmation.status": "available", "next_step.action": "ticket",
                           "next_step.consecutive_failures": 2},
              "db": {"unchanged": ["orders", "return_requests", "return_cards"],
                     "counts": {"ticket_events[trigger=technical_failure]": 1}}}},
  {"id": "click-after-failure", "as": "alice", "call": "POST /sessions/{sid}/cards/{action2}/confirm",
   "body": {"version": 2, "reason_code": "quality_issue", "reason_text": "", "request_id": "g11-click"},
   "expect": {"status": 200, "model_calls": 0,
              "response": {"card.status": "consumed", "return_request.order_id": "O1001",
                           "confirmation_message": {"$contains": "原因：质量问题"}},
              "db": {"rows": {"return_requests": [{"customer_id": "alice", "order_id": "O1001",
                                                   "reason_code": "quality_issue", "reason_text": null,
                                                   "source_action_id": "{action2}"}]}}}},
  {"id": "submitted-card-cannot-be-voided", "as": "alice", "call": "POST /sessions/{sid}/cards/{action2}/void",
   "body": {"request_id": "g11-void-late"},
   "expect": {"status": 409, "model_calls": 0, "response": {"error.code": "CONFIRMATION_INVALID"},
              "db": {"unchanged_except": ["session_requests"],
                     "counts": {"return_requests": 1, "return_cards[status=consumed]": 1}}}},
  {"id": "history-records-every-click", "as": "alice", "call": "GET /sessions/{sid}/history",
   "expect": {"status": 200,
              "response": {"@history_entries": ["card_prepare", "turn", "cancel", "card_void", "card_void", "card_void",
                                                "card_confirm", "card_prepare", "turn", "card_confirm", "card_void"]},
              "db": {"unchanged": "all"}}}
 ]
}
