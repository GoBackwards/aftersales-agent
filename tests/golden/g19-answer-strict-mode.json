{
 "schema_version": "golden-scenario-v1",
 "scenario_id": "G19-answer-strict-mode",
 "summary": "B5a 起答复调用走严格模式，B5d2 起答复函数是 respond：规划和答复两次调用都把自己的函数标为严格；respond 只提供本轮有得选的字段，没有可引用的结果项就不提供 claims，本人有订单时提供 show_order_ids；按严格模式写出的答复（只含提供的字段）与带着空列表的完整答复得到同一句回复；B5f 起只有越出本轮清单的编号这类结构问题才退回纠错一次（重复事项、超出上限的结果项改为由代码去掉，见 G25）；这些轮次都不写订单、申请、确认卡和工单",
 "covers": ["B5a-answer-strict-mode", "B5d2-respond-strict", "G9", "D11", "D12", "K14"],
 "customers": ["alice"],
 "steps": [
  {"id": "open", "as": "alice", "call": "POST /sessions", "body": {}, "save": {"sid": "session_id"},
   "expect": {"status": 201}},
  {"id": "a-strict-answer-carries-only-the-offered-fields", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "你好，我先随便问问。", "request_id": "g19-free-strict"},
   "model": [{"plan": {"items": []}},
             {"tool": "respond",
              "arguments": {"items": [{"index": 1, "disposition": "asked", "path_id": "none", "note": ""}],
                            "show_order_ids": [], "next_step": "",
                            "ask": {"text": "好的，你想先解决哪件事？", "option_set_id": "none"}}}],
   "expect": {"status": 200, "model_calls": 2,
              "model_requests": [{"tool": "plan_turn", "strict": true},
                                 {"tool": "respond", "strict": true,
                                  "offered": ["ask", "items", "next_step", "show_order_ids"],
                                  "item_kinds": ["message"]}],
              "response": {"run_status": "completed", "reply": "好的，你想先解决哪件事？",
                           "@block_authors": [["ask", "model"]], "@demo_words": 0},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "tickets", "ticket_events"],
                     "counts": {"session_runs[status=completed]": 1}}}},
  {"id": "a-full-answer-with-empty-lists-reads-the-same", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "你好，我先随便问问。", "request_id": "g19-free-full"},
   "model": [{"plan": {"items": []}},
             {"tool": "respond",
              "arguments": {"items": [{"index": 1, "disposition": "asked", "claims": [], "path_id": "none", "note": ""}],
                            "show_order_ids": [], "next_step": "",
                            "ask": {"text": "好的，你想先解决哪件事？", "option_set_id": "none"}}}],
   "expect": {"status": 200, "model_calls": 2,
              "response": {"run_status": "completed", "reply": "好的，你想先解决哪件事？"},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "tickets", "ticket_events"],
                     "counts": {"session_runs[status=completed]": 2}}}},
  {"id": "an-id-outside-the-turns-lists-goes-back-once", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "收到商品以后，一般隔多久就不能再退了？", "request_id": "g19-policy"},
   "model": [{"plan": {"items": [{"kind": "policy_question", "quote": "收到商品以后，一般隔多久就不能再退了"}]}},
             {"tool": "respond",
              "arguments": {"items": [{"index": 1, "disposition": "gap", "path_id": "no_such_path",
                                       "note": "我这边的资料没写到这一项。"}],
                            "show_order_ids": [], "next_step": "", "ask": {"text": "", "option_set_id": "none"}}},
             {"answer": {"note": "我这边的资料没写到这一项。", "path": "policy_page"}}],
   "expect": {"status": 200, "model_calls": 3,
              "model_requests": [{"tool": "plan_turn", "strict": true},
                                 {"tool": "respond", "strict": true, "offered": ["ask", "items", "next_step", "show_order_ids"],
                                  "item_kinds": ["policy_question"]},
                                 {"tool": "respond", "strict": true, "offered": ["ask", "items", "next_step", "show_order_ids"]}],
              "response": {"run_status": "completed", "@trace_types": {"$contains": "structure_correction"},
                           "@block_authors": [["text", "model"], ["path", "code"]], "@demo_words": 0},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "tickets", "ticket_events"],
                     "counts": {"session_runs[status=completed]": 3, "session_runs": 3}}}}
 ]
}
