{
 "schema_version": "golden-scenario-v1",
 "scenario_id": "G05-same-order-two-sessions",
 "summary": "I15 末项：同一客户两个会话各有同一订单的有效卡，先后点击确认，第二次返回已有申请、卡置为已消费，申请仍只有一条，原因码以第一次点击为准",
 "covers": ["I15", "I3", "I2"],
 "customers": ["alice"],
 "steps": [
  {"id": "open-first", "as": "alice", "call": "POST /sessions", "body": {}, "save": {"first": "session_id"},
   "expect": {"status": 201}},
  {"id": "card-first", "as": "alice", "call": "POST /sessions/{first}/messages",
   "body": {"message": "保温杯 O1001 申请退回，理由：杯盖拧不紧", "request_id": "g05-first"},
   "model": [{"plan": {"items": [{"kind": "return_request", "quote": "申请退回", "order_quote": "O1001", "order_id": "O1001"}]}}],
   "save": {"action1": "confirmation.action_id", "version1": "confirmation.version"},
   "expect": {"status": 200, "model_calls": 1, "response": {"confirmation.status": "available"}}},
  {"id": "open-second", "as": "alice", "call": "POST /sessions", "body": {}, "save": {"second": "session_id"},
   "expect": {"status": 201}},
  {"id": "card-second", "as": "alice", "call": "POST /sessions/{second}/messages",
   "body": {"message": "换个窗口再说一次：O1001 申请退回，理由：杯盖拧不紧", "request_id": "g05-second"},
   "model": [{"plan": {"items": [{"kind": "return_request", "quote": "申请退回", "order_quote": "O1001", "order_id": "O1001"}]}}],
   "save": {"action2": "confirmation.action_id", "version2": "confirmation.version"},
   "expect": {"status": 200, "model_calls": 1, "response": {"confirmation.status": "available"},
              "db": {"counts": {"return_cards[status=pending]": 2, "return_requests": 0}}}},
  {"id": "click-first", "as": "alice", "call": "POST /sessions/{first}/cards/{action1}/confirm",
   "body": {"version": "{version1}", "reason_code": "quality_issue", "reason_text": "", "request_id": "g05-click-1"},
   "expect": {"status": 200, "response": {"return_request.order_id": "O1001", "card.status": "consumed"},
              "db": {"counts": {"return_requests": 1}}}},
  {"id": "click-second", "as": "alice", "call": "POST /sessions/{second}/cards/{action2}/confirm",
   "body": {"version": "{version2}", "reason_code": "changed_mind", "reason_text": "", "request_id": "g05-click-2"},
   "expect": {"status": 200, "response": {"return_request.order_id": "O1001", "card.status": "consumed"},
              "db": {"unchanged": ["return_requests", "orders"],
                     "counts": {"return_requests": 1, "return_cards[status=consumed]": 2},
                     "rows": {"return_requests": [{"order_id": "O1001", "reason_code": "quality_issue"}]}}}}
 ]
}
