{
 "schema_version": "golden-scenario-v1",
 "scenario_id": "G16-failure-next-step-and-ticket",
 "summary": "B4b 失败策略：每个失败轮只给一个下一步。单次失败给“重试”（同一句换新 request_id 重发），不开工单、不写每次失败的处理记录；连续第二个失败轮开人工工单（trigger technical_failure）并在回复里明说，下一步是原平台渠道，同一条回复里没有重试；再失败就追加到这张工单；本人撤回后，同一串失败不再重开；一个完成的轮次（这里是条目被驳回、咨询照答的降级轮）结束这一串，之后要再连续失败两次才开新工单；失败轮不改确认卡，卡仍只凭点击提交；GET /tickets 按记录列出工单和事件的触发原因",
 "covers": ["B4b-one-next-step", "B4b-consecutive-failures", "HO4", "HR5", "W6", "K11", "I8", "I6"],
 "customers": ["alice"],
 "steps": [
  {"id": "open", "as": "alice", "call": "POST /sessions", "body": {}, "save": {"sid": "session_id"},
   "expect": {"status": 201}},
  {"id": "button-card", "as": "alice", "call": "POST /sessions/{sid}/cards",
   "body": {"order_id": "O1001", "request_id": "g16-card"},
   "save": {"action": "card.action_id", "version": "card.version"},
   "expect": {"status": 200, "model_calls": 0, "response": {"card_outcome": "created", "card.status": "pending"}}},
  {"id": "first-failure-offers-a-retry", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "顺手再打听一件不相干的小事", "request_id": "g16-fail-1"},
   "model": [{"raise": "model_error"}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"run_status": "model_error", "next_step.action": "retry", "next_step.consecutive_failures": 1,
                           "handoff": {"$absent": true}, "@ticket_card": {"$absent": true},
                           "reply": {"$ordered": ["这一轮没有处理完。", "待确认：", "O1001",
                                                  "可以点“重试”再发一次这条消息。"]},
                           "session.card.status": "pending"},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "tickets", "ticket_events", "handoffs"],
                     "counts": {"session_runs[status=model_error]": 1}}}},
  {"id": "retry-fails-again-and-opens-a-ticket", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "顺手再打听一件不相干的小事", "request_id": "g16-fail-2"},
   "model": [{"raise": "model_error"}],
   "save": {"ticket": "ticket_card.ticket_id"},
   "expect": {"status": 200, "model_calls": 1,
              "response": {"run_status": "model_error", "next_step.action": "ticket",
                           "next_step.consecutive_failures": 2, "next_step.ticket_outcome": "opened",
                           "@ticket_card": {"short_no": "H-0001", "status": "pending", "actions": ["withdraw"]},
                           "reply": {"$ordered": ["这一轮没有处理完。", "待确认：",
                                                  "上一轮也没有处理完，已提交人工工单 H-0001，当前状态：待处理。可以随时撤回。",
                                                  "请通过原平台对应订单或服务页面的客服渠道"]},
                           "session.card.status": "pending"},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "handoffs"],
                     "counts": {"tickets[status=pending,urgency=normal]": 1,
                                "ticket_events[kind=opened,trigger=technical_failure]": 1}}}},
  {"id": "the-ticket-reply-offers-no-retry", "as": "alice", "call": "GET /sessions/{sid}",
   "expect": {"status": 200, "response": {"last_reply": {"$lacks": "重试"}, "card.status": "pending"},
              "db": {"unchanged": "all"}}},
  {"id": "third-failure-appends", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "顺手再打听一件不相干的小事", "request_id": "g16-fail-3"},
   "model": [{"raise": "model_error"}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"next_step.action": "ticket", "next_step.consecutive_failures": 3,
                           "next_step.ticket_outcome": "appended",
                           "reply": {"$contains": "上一轮也没有处理完，已追加到人工工单 H-0001，当前状态：待处理。"}},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "handoffs"],
                     "counts": {"tickets": 1, "ticket_events[kind=appended,trigger=technical_failure]": 1}}}},
  {"id": "owner-withdraws", "as": "alice", "call": "POST /sessions/{sid}/tickets/{ticket}/withdraw",
   "body": {"request_id": "g16-withdraw"},
   "expect": {"status": 200, "model_calls": 0,
              "response": {"ticket_outcome": "withdrawn", "ticket.status": "cancelled"}}},
  {"id": "same-run-does-not-reopen", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "顺手再打听一件不相干的小事", "request_id": "g16-fail-4"},
   "model": [{"raise": "model_error"}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"next_step.action": "retry", "next_step.consecutive_failures": 4,
                           "@ticket_card": {"$absent": true},
                           "reply": {"$ordered": ["这一轮没有处理完。", "待确认：", "可以点“重试”再发一次这条消息。"]}},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "tickets", "ticket_events", "handoffs"]}}},
  {"id": "degraded-turn-ends-the-run", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "上回那件东西也一起退了吧", "request_id": "g16-degraded"},
   "model": [{"plan": {"items": [{"kind": "return_request", "quote": "签收那天"}]}},
             {"answer": {"note": "想退哪一单，可以直接写订单号。"}}],
   "expect": {"status": 200, "model_calls": 2,
              "response": {"run_status": "completed", "next_step.action": {"$absent": true},
                           "@trace_types": {"$contains": "item_rejected"},
                           "reply": {"$contains": "这条消息里有一项要办的事这次没有办理"}},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "tickets", "ticket_events", "handoffs"]}}},
  {"id": "failure-after-the-degraded-turn-is-a-first", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "顺手再打听一件不相干的小事", "request_id": "g16-fail-5"},
   "model": [{"raise": "model_error"}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"next_step.action": "retry", "next_step.consecutive_failures": 1},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "tickets", "ticket_events", "handoffs"]}}},
  {"id": "second-of-a-new-run-opens-another", "as": "alice", "call": "POST /sessions/{sid}/messages",
   "body": {"message": "顺手再打听一件不相干的小事", "request_id": "g16-fail-6"},
   "model": [{"raise": "model_error"}],
   "expect": {"status": 200, "model_calls": 1,
              "response": {"next_step.action": "ticket", "next_step.consecutive_failures": 2,
                           "next_step.ticket_outcome": "opened",
                           "@ticket_card": {"short_no": "H-0002", "status": "pending", "actions": ["withdraw"]}},
              "db": {"unchanged": ["orders", "return_requests", "return_cards", "handoffs"],
                     "counts": {"tickets": 2, "tickets[status=pending]": 1, "tickets[status=cancelled]": 1}}}},
  {"id": "tickets-list-the-triggers", "as": "alice", "call": "GET /tickets",
   "expect": {"status": 200,
              "response": {"@ticket_statuses": [["H-0001", "cancelled"], ["H-0002", "pending"]],
                           "@ticket_events": [["H-0001", "opened", "technical_failure"],
                                              ["H-0001", "appended", "technical_failure"],
                                              ["H-0001", "withdrawn", "user_request"],
                                              ["H-0002", "opened", "technical_failure"]]},
              "db": {"unchanged": "all"}}},
  {"id": "the-card-is-still-submitted-only-by-a-click", "as": "alice", "call": "POST /sessions/{sid}/cards/{action}/confirm",
   "body": {"version": "{version}", "reason_code": "size_or_style", "reason_text": "", "request_id": "g16-click"},
   "expect": {"status": 200, "model_calls": 0,
              "response": {"card.status": "consumed", "return_request.order_id": "O1001"},
              "db": {"rows": {"return_requests": [{"customer_id": "alice", "order_id": "O1001",
                                                   "reason_code": "size_or_style", "source_action_id": "{action}"}]}}}},
  {"id": "history-keeps-each-turns-next-step", "as": "alice", "call": "GET /sessions/{sid}/history",
   "expect": {"status": 200,
              "response": {"@history_entries": ["card_prepare", "turn", "turn", "turn", "ticket_withdraw", "turn", "turn",
                                                "turn", "turn", "card_confirm"]},
              "db": {"unchanged": "all"}}}
 ]
}
